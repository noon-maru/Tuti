# 외부 Android 실기기에서 접근 가능한 개발 API의 HTTPS 주소입니다.
# localhost, NAS 사설 IP와 http:// 주소는 사용할 수 없습니다.
NEXT_PUBLIC_API_BASE_URL=https://dev.example.com/api

# 개발용 앱에서도 실제 인증 공급자를 시험할 때만 true로 설정합니다.
NEXT_PUBLIC_ACCOUNT_AUTH_ENABLED=true
NEXT_PUBLIC_SOCIAL_OAUTH_ENABLED=false
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=false
