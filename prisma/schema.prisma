generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementLevel {
  near
  short
  half
}

enum TransportHubMode {
  rail
  express_bus
}

enum AuthProvider {
  email
  apple
  google
  kakao
}

enum UserRole {
  user
  admin
}

enum PlaceReviewStatus {
  pending
  approved
  rejected
}

enum PlaceCandidateStatus {
  selected
  enrich
  pending
  low_burden_mismatch
  invalid
}

enum PlaceCandidateOverride {
  auto
  include
  exclude
}

enum PlaceVisibilityOverride {
  auto
  show
  hide
}

enum LogLevel {
  info
  warning
  error
}

enum ReportReason {
  inappropriate
  copyright
  privacy
  spam
  other
}

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum InquiryCategory {
  account
  service
  place
  privacy
  other
}

enum InquiryStatus {
  pending
  reviewing
  answered
  closed
}

enum RecommendationActionType {
  recommendation_shown
  place_selected
  departure_peek_opened
  departure_plan_expanded
  navigation_started
  return_confirmed
  return_dismissed
  return_deferred
  journal_started
  journal_created
}

model Place {
  id                        String                                @id
  name                      String
  phrase                    String
  note                      String
  image                     String
  travelTime                String                                @map("travel_time")
  crowd                     String
  today                     String
  fatigue                   Int
  movementLevel             MovementLevel                         @map("movement_level")
  moodTags                  String[]                              @map("mood_tags")
  latitude                  Decimal                               @db.Decimal(9, 6)
  longitude                 Decimal                               @db.Decimal(9, 6)
  location                  Unsupported("geometry(Point, 4326)")?
  source                    String                                @default("manual")
  sourceId                  String?                               @map("source_id")
  sourceContentType         String?                               @map("source_content_type")
  sourceAddress             String?                               @map("source_address")
  sourceAreaCode            String?                               @map("source_area_code")
  sourceSidoName            String?                               @map("source_sido_name")
  sourceSigunguCode         String?                               @map("source_sigungu_code")
  sourceSigunguName         String?                               @map("source_sigungu_name")
  sourceCopyright           String?                               @map("source_copyright")
  sourceModifiedAt          DateTime?                             @map("source_modified_at")
  sourceSyncedAt            DateTime?                             @map("source_synced_at")
  reviewStatus              PlaceReviewStatus                     @default(approved) @map("review_status")
  isActive                  Boolean                               @default(true) @map("is_active")
  candidateStatus           PlaceCandidateStatus?                 @map("candidate_status")
  candidateScore            Int?                                  @map("candidate_score")
  candidateSections         Json?                                 @map("candidate_sections")
  candidateReasons          String[]                              @default([]) @map("candidate_reasons")
  candidateExclusions       String[]                              @default([]) @map("candidate_exclusions")
  candidateEvaluatedAt      DateTime?                             @map("candidate_evaluated_at")
  candidateAlgorithmVersion String?                               @map("candidate_algorithm_version")
  candidateOverride         PlaceCandidateOverride                @default(auto) @map("candidate_override")
  visibilityOverride        PlaceVisibilityOverride               @default(auto) @map("visibility_override")
  createdAt                 DateTime                              @default(now()) @map("created_at")
  updatedAt                 DateTime                              @updatedAt @map("updated_at")
  tourismSourceRecord       TourismPlaceSourceRecord?
  seoulRealtimeAreaLink     PlaceSeoulRealtimeArea?
  crowdEstimates            PlaceCrowdEstimate[]
  journalEntries            JournalEntry[]
  recommendationActions     RecommendationAction[]

  @@unique([source, sourceId])
  @@index([fatigue])
  @@index([movementLevel])
  @@index([source, reviewStatus, isActive])
  @@index([source, sourceContentType, reviewStatus])
  @@index([source, candidateStatus, candidateOverride])
  @@index([source, candidateStatus, visibilityOverride])
  @@map("places")
}

model TransportHub {
  id           String           @id @default(cuid())
  source       String
  externalId   String           @map("external_id")
  mode         TransportHubMode
  name         String
  aliases      String[]         @default([])
  cityCode     String?          @map("city_code")
  regionName   String?          @map("region_name")
  latitude     Decimal          @db.Decimal(9, 6)
  longitude    Decimal          @db.Decimal(9, 6)
  rawPayload   Json?            @map("raw_payload")
  isActive     Boolean          @default(true) @map("is_active")
  sourceSyncedAt DateTime       @map("source_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([source, externalId])
  @@index([mode, isActive])
  @@index([cityCode])
  @@map("transport_hubs")
}

model AccommodationSourceRecord {
  contentId          String    @id @map("content_id")
  contentTypeId      String    @default("32") @map("content_type_id")
  name               String
  address            String?
  areaCode           String?   @map("area_code")
  sigunguCode        String?   @map("sigungu_code")
  latitude           Decimal   @db.Decimal(9, 6)
  longitude          Decimal   @db.Decimal(9, 6)
  image              String?
  thumbnail          String?
  phone              String?
  categoryCode       String?   @map("category_code")
  checkInTime        String?   @map("check_in_time")
  checkOutTime       String?   @map("check_out_time")
  roomCount          String?   @map("room_count")
  roomType           String?   @map("room_type")
  reservation        String?
  reservationUrl     String?   @map("reservation_url")
  parking            String?
  pickup             String?
  foodPlace          String?   @map("food_place")
  subFacility        String?   @map("sub_facility")
  homepage           String?
  overview           String?
  rawPayload         Json      @map("raw_payload")
  introPayload       Json?     @map("intro_payload")
  infoPayload        Json?     @map("info_payload")
  imagePayload       Json?     @map("image_payload")
  sourceModifiedAt   DateTime? @map("source_modified_at")
  sourceSyncedAt     DateTime  @map("source_synced_at")
  detailSyncedAt     DateTime? @map("detail_synced_at")
  detailRetryAfter   DateTime? @map("detail_retry_after")
  detailLastError    String?   @map("detail_last_error")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([areaCode, sigunguCode])
  @@index([latitude, longitude])
  @@index([isActive, detailSyncedAt])
  @@map("accommodation_source_records")
}

model TourismPlaceSourceRecord {
  contentId        String                    @id @map("content_id")
  contentTypeId    String?                   @map("content_type_id")
  title            String
  areaCode         String?                   @map("area_code")
  sidoName         String?                   @map("sido_name")
  sigunguCode      String?                   @map("sigungu_code")
  sigunguName      String?                   @map("sigungu_name")
  rawPayload       Json                      @map("raw_payload")
  linkedPlaceId    String?                   @unique @map("linked_place_id")
  sourceModifiedAt DateTime?                 @map("source_modified_at")
  syncedAt         DateTime                  @map("synced_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  linkedPlace      Place?                    @relation(fields: [linkedPlaceId], references: [id], onDelete: SetNull)
  detailRecord     TourismPlaceDetailRecord?

  @@index([contentTypeId, syncedAt])
  @@index([areaCode, sigunguCode])
  @@index([sidoName, sigunguName])
  @@map("tourism_place_source_records")
}

model TourismPlaceDetailRecord {
  contentId           String                   @id @map("content_id")
  contentTypeId       String?                  @map("content_type_id")
  overview            String?
  homepage            String?
  phone               String?
  openingHours        String?                  @map("opening_hours")
  restDate            String?                  @map("rest_date")
  admissionFee        String?                  @map("admission_fee")
  parking             String?
  reservation         String?
  usageDuration       String?                  @map("usage_duration")
  experienceGuide     String?                  @map("experience_guide")
  commonPayload       Json?                    @map("common_payload")
  introPayload        Json?                    @map("intro_payload")
  infoPayload         Json?                    @map("info_payload")
  imagePayload        Json?                    @map("image_payload")
  sourceModifiedAt    DateTime?                @map("source_modified_at")
  editorialSyncedAt   DateTime?                @map("editorial_synced_at")
  editorialAttemptAt  DateTime?                @map("editorial_attempt_at")
  editorialRetryAfter DateTime?                @map("editorial_retry_after")
  editorialLastError  String?                  @map("editorial_last_error")
  syncedAt            DateTime?                @map("synced_at")
  lastAttemptAt       DateTime?                @map("last_attempt_at")
  retryAfter          DateTime?                @map("retry_after")
  lastError           String?                  @map("last_error")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  sourceRecord        TourismPlaceSourceRecord @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@index([retryAfter])
  @@index([editorialRetryAfter])
  @@index([editorialSyncedAt])
  @@index([syncedAt])
  @@map("tourism_place_detail_records")
}

model WellnessTourismSourceRecord {
  id                String    @id
  contentId         String    @map("content_id")
  contentTypeId     String?   @map("content_type_id")
  langDivCd         String    @map("lang_div_cd")
  title             String
  wellnessThemeCode String?   @map("wellness_theme_code")
  areaCode          String?   @map("area_code")
  sigunguCode       String?   @map("sigungu_code")
  rawPayload        Json      @map("raw_payload")
  sourceModifiedAt  DateTime? @map("source_modified_at")
  syncedAt          DateTime  @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([contentId, langDivCd])
  @@index([wellnessThemeCode, syncedAt])
  @@index([areaCode, sigunguCode])
  @@map("wellness_tourism_source_records")
}

model MunicipalCoreTourismSourceRecord {
  id                 String   @id
  baseYm             String   @map("base_ym")
  areaCode           String   @map("area_code")
  areaName           String   @map("area_name")
  sigunguCode        String   @map("sigungu_code")
  sigunguName        String   @map("sigungu_name")
  touristSpotCode    String   @map("tourist_spot_code")
  touristSpotName    String   @map("tourist_spot_name")
  rank               Int
  categoryLargeName  String?  @map("category_large_name")
  categoryMediumName String?  @map("category_medium_name")
  longitude          Decimal? @db.Decimal(11, 8)
  latitude           Decimal? @db.Decimal(10, 8)
  rawPayload         Json     @map("raw_payload")
  syncedAt           DateTime @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([baseYm, areaCode, sigunguCode, touristSpotCode])
  @@index([baseYm, areaCode, sigunguCode, rank])
  @@index([touristSpotName])
  @@map("municipal_core_tourism_source_records")
}

model RelatedTourismSourceRecord {
  id                        String   @id
  baseYm                    String   @map("base_ym")
  touristSpotCode           String   @map("tourist_spot_code")
  touristSpotName           String   @map("tourist_spot_name")
  areaCode                  String   @map("area_code")
  areaName                  String   @map("area_name")
  sigunguCode               String   @map("sigungu_code")
  sigunguName               String   @map("sigungu_name")
  relatedTouristSpotCode    String   @map("related_tourist_spot_code")
  relatedTouristSpotName    String   @map("related_tourist_spot_name")
  relatedAreaCode           String   @map("related_area_code")
  relatedAreaName           String   @map("related_area_name")
  relatedSigunguCode        String   @map("related_sigungu_code")
  relatedSigunguName        String   @map("related_sigungu_name")
  relatedCategoryLargeName  String?  @map("related_category_large_name")
  relatedCategoryMediumName String?  @map("related_category_medium_name")
  relatedCategorySmallName  String?  @map("related_category_small_name")
  rank                      Int
  rawPayload                Json     @map("raw_payload")
  syncedAt                  DateTime @map("synced_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([baseYm, touristSpotCode, relatedTouristSpotCode])
  @@index([baseYm, areaCode, sigunguCode, touristSpotCode, rank])
  @@index([touristSpotName])
  @@index([relatedTouristSpotName])
  @@map("related_tourism_source_records")
}

model TouristSpotConcentrationRateRecord {
  id                String   @id
  baseYmd           String   @map("base_ymd")
  areaCode          String   @map("area_code")
  areaName          String   @map("area_name")
  sigunguCode       String   @map("sigungu_code")
  sigunguName       String   @map("sigungu_name")
  touristSpotName   String   @map("tourist_spot_name")
  concentrationRate Decimal  @map("concentration_rate") @db.Decimal(10, 4)
  rawPayload        Json     @map("raw_payload")
  syncedAt          DateTime @map("synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([baseYmd, areaCode, sigunguCode, touristSpotName])
  @@index([areaCode, sigunguCode, baseYmd])
  @@index([touristSpotName, baseYmd])
  @@map("tourist_spot_concentration_rate_records")
}

model SeoulRealtimeArea {
  areaCode        String                                      @id @map("area_code")
  areaName        String                                      @map("area_name")
  category        String
  geometry        Unsupported("geometry(MultiPolygon, 4326)")
  sourceSyncedAt  DateTime                                    @map("source_synced_at")
  createdAt       DateTime                                    @default(now()) @map("created_at")
  updatedAt       DateTime                                    @updatedAt @map("updated_at")
  placeLinks      PlaceSeoulRealtimeArea[]
  populationCache SeoulRealtimePopulationCache?

  @@index([category])
  @@map("seoul_realtime_areas")
}

model PlaceSeoulRealtimeArea {
  placeId     String            @id @map("place_id")
  areaCode    String            @map("area_code")
  matchMethod String            @default("contains") @map("match_method")
  confidence  Decimal           @default(1) @db.Decimal(4, 3)
  linkedAt    DateTime          @default(now()) @map("linked_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  place       Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  area        SeoulRealtimeArea @relation(fields: [areaCode], references: [areaCode], onDelete: Cascade)

  @@index([areaCode])
  @@map("place_seoul_realtime_areas")
}

model SeoulRealtimePopulationCache {
  areaCode          String            @id @map("area_code")
  areaName          String            @map("area_name")
  congestionLevel   String            @map("congestion_level")
  congestionMessage String?           @map("congestion_message")
  populationMin     Int?              @map("population_min")
  populationMax     Int?              @map("population_max")
  observedAt        DateTime          @map("observed_at")
  forecastPayload   Json?             @map("forecast_payload")
  rawPayload        Json              @map("raw_payload")
  fetchedAt         DateTime          @map("fetched_at")
  expiresAt         DateTime          @map("expires_at")
  area              SeoulRealtimeArea @relation(fields: [areaCode], references: [areaCode], onDelete: Cascade)

  @@index([expiresAt])
  @@map("seoul_realtime_population_cache")
}

model PlaceCrowdEstimate {
  placeId                 String   @map("place_id")
  forecastDate            String   @map("forecast_date")
  level                   String
  score                   Decimal  @db.Decimal(5, 2)
  confidence              String
  visitorPressure         Decimal? @map("visitor_pressure") @db.Decimal(5, 2)
  centralityPressure      Decimal? @map("centrality_pressure") @db.Decimal(5, 2)
  regionalDemandPressure  Decimal? @map("regional_demand_pressure") @db.Decimal(5, 2)
  basis                   Json
  algorithmVersion        String   @map("algorithm_version")
  calculatedAt            DateTime @map("calculated_at")
  place                   Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, forecastDate])
  @@index([forecastDate, level])
  @@index([calculatedAt])
  @@map("place_crowd_estimates")
}

model RegionalVisitorCountRecord {
  id               String   @id
  aggregationLevel String   @map("aggregation_level")
  baseYmd          String   @map("base_ymd")
  regionCode       String   @map("region_code")
  regionName       String   @map("region_name")
  weekdayCode      String   @map("weekday_code")
  weekdayName      String   @map("weekday_name")
  visitorTypeCode  String   @map("visitor_type_code")
  visitorTypeName  String   @map("visitor_type_name")
  visitorCount     Decimal  @map("visitor_count") @db.Decimal(20, 0)
  rawPayload       Json     @map("raw_payload")
  syncedAt         DateTime @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([aggregationLevel, baseYmd, regionCode, weekdayCode, visitorTypeCode])
  @@index([aggregationLevel, baseYmd, regionCode])
  @@index([regionName, baseYmd])
  @@map("regional_visitor_count_records")
}

model TourismPhotoGallerySourceRecord {
  contentId           String    @id @map("content_id")
  contentTypeId       String?   @map("content_type_id")
  title               String
  imageUrl            String    @map("image_url")
  useFlag             String?   @map("use_flag")
  photographyMonth    String?   @map("photography_month")
  photographyLocation String?   @map("photography_location")
  photographer        String?   @map("photographer")
  searchKeyword       String?   @map("search_keyword")
  sourceCreatedAt     DateTime? @map("source_created_at")
  sourceModifiedAt    DateTime? @map("source_modified_at")
  rawPayload          Json      @map("raw_payload")
  syncedAt            DateTime  @map("synced_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([photographyLocation, syncedAt])
  @@index([sourceModifiedAt])
  @@map("tourism_photo_gallery_source_records")
}

model TourismRegionMetric {
  id          String   @id
  dataset     String
  metricType  String   @map("metric_type")
  metricCode  String   @map("metric_code")
  metricName  String   @map("metric_name")
  metricValue Decimal? @map("metric_value") @db.Decimal(20, 4)
  baseYm      String   @map("base_ym")
  areaCode    String   @map("area_code")
  areaName    String   @map("area_name")
  sigunguCode String   @map("sigungu_code")
  sigunguName String   @map("sigungu_name")
  rawPayload  Json     @map("raw_payload")
  syncedAt    DateTime @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([metricType, metricCode, baseYm, areaCode, sigunguCode])
  @@index([dataset, baseYm])
  @@index([areaCode, sigunguCode, baseYm])
  @@map("tourism_region_metrics")
}

model ExternalDataSyncRun {
  id            String    @id
  source        String
  operation     String
  status        String
  parameters    Json?
  receivedCount Int       @default(0) @map("received_count")
  createdCount  Int       @default(0) @map("created_count")
  updatedCount  Int       @default(0) @map("updated_count")
  skippedCount  Int       @default(0) @map("skipped_count")
  failedCount   Int       @default(0) @map("failed_count")
  errorMessage  String?   @map("error_message")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([source, startedAt])
  @@index([status, startedAt])
  @@map("external_data_sync_runs")
}

model ExternalDataSyncCheckpoint {
  source      String
  jobKey      String   @map("job_key")
  operation   String
  parameters  Json?
  completedAt DateTime @map("completed_at")

  @@id([source, jobKey])
  @@index([source, completedAt])
  @@map("external_data_sync_checkpoints")
}

model JournalEntry {
  id          String    @id
  ownerId     String    @map("owner_id")
  title       String
  content     String
  image       String?
  crowd       String
  placeId     String?   @map("place_id")
  placeName   String    @map("place_name")
  theme       String    @default("미정")
  difficulty  String
  visitedAt   DateTime  @map("visited_at")
  publicId    String?   @unique @map("public_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  place       Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([ownerId, visitedAt])
  @@index([placeId])
  @@map("journal_entries")
}

model JournalShareTrace {
  traceId        String    @id @map("trace_id")
  shortCode      String    @unique @map("short_code")
  originUserId   String    @map("origin_user_id")
  resolvedUserId String    @map("resolved_user_id")
  entryId        String    @map("entry_id")
  imageSha256    String?   @map("image_sha256")
  signature      String?
  issuedAt       DateTime  @default(now()) @map("issued_at")
  finalizedAt    DateTime? @map("finalized_at")

  @@index([originUserId])
  @@index([resolvedUserId])
  @@index([entryId])
  @@index([issuedAt])
  @@map("journal_share_traces")
}

model User {
  id                    String                 @id
  tokenHash             String                 @unique @map("token_hash")
  role                  UserRole               @default(user)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  authIdentities        AuthIdentity[]
  journalEntries        JournalEntry[]
  oauthAuthorizations   OAuthAuthorization[]
  sessions              UserSession[]
  recommendationActions RecommendationAction[]
  recommendationRuns    RecommendationRun[]

  @@map("users")
}

model RecommendationRun {
  id               String   @id
  userId           String   @map("user_id")
  algorithmVersion String   @map("algorithm_version")
  answers          Json
  state            Json
  entryStatus      String?  @map("entry_status")
  locationUsed     Boolean  @default(false) @map("location_used")
  stateTextUsed    Boolean  @default(false) @map("state_text_used")
  candidates       Json
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([algorithmVersion, createdAt])
  @@index([createdAt])
  @@map("recommendation_runs")
}

model RecommendationAction {
  id        String                   @id
  journeyId String                   @map("journey_id")
  userId    String                   @map("user_id")
  placeId   String?                  @map("place_id")
  action    RecommendationActionType
  routeMode String?                  @map("route_mode")
  metadata  Json?
  createdAt DateTime                 @default(now()) @map("created_at")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place?                   @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([journeyId, createdAt])
  @@index([userId, createdAt])
  @@index([placeId, action, createdAt])
  @@index([action, createdAt])
  @@map("recommendation_actions")
}

model SystemLog {
  id          String   @id
  level       LogLevel @default(info)
  category    String
  action      String
  message     String
  actorUserId String?  @map("actor_user_id")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("system_logs")
}

model ContentReport {
  id             String       @id
  reporterUserId String       @map("reporter_user_id")
  entryId        String?      @map("entry_id")
  targetOwnerId  String       @map("target_owner_id")
  targetTitle    String       @map("target_title")
  targetPublicId String?      @map("target_public_id")
  reason         ReportReason
  detail         String?
  status         ReportStatus @default(pending)
  reviewerUserId String?      @map("reviewer_user_id")
  resolutionNote String?      @map("resolution_note")
  reviewedAt     DateTime?    @map("reviewed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([entryId])
  @@index([reporterUserId, createdAt])
  @@map("content_reports")
}

model AppSetting {
  key             String   @id
  value           String
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model CustomerInquiry {
  id              String          @id
  requesterUserId String?         @map("requester_user_id")
  requesterEmail  String?         @map("requester_email")
  category        InquiryCategory
  subject         String
  message         String
  status          InquiryStatus   @default(pending)
  adminResponse   String?         @map("admin_response")
  handledByUserId String?         @map("handled_by_user_id")
  handledAt       DateTime?       @map("handled_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([requesterEmail])
  @@map("customer_inquiries")
}

model AuthIdentity {
  id              String       @id
  userId          String       @map("user_id")
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model EmailVerificationCode {
  id         String    @id
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model OAuthAuthorization {
  id                  String       @id
  userId              String       @map("user_id")
  provider            AuthProvider
  stateHash           String       @unique @map("state_hash")
  codeVerifier        String       @map("code_verifier")
  returnTo            String       @default("/") @map("return_to")
  providerSubject     String?      @map("provider_subject")
  providerEmail       String?      @map("provider_email")
  completionTokenHash String?      @unique @map("completion_token_hash")
  completedAt         DateTime?    @map("completed_at")
  expiresAt           DateTime     @map("expires_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model UserSession {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
