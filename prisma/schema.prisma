generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementLevel {
  near
  short
  half
}

enum AuthProvider {
  email
  apple
  google
  kakao
}

enum UserRole {
  user
  admin
}

enum PlaceReviewStatus {
  pending
  approved
  rejected
}

enum LogLevel {
  info
  warning
  error
}

enum ReportReason {
  inappropriate
  copyright
  privacy
  spam
  other
}

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum InquiryCategory {
  account
  service
  place
  privacy
  other
}

enum InquiryStatus {
  pending
  reviewing
  answered
  closed
}

model Place {
  id            String                                @id
  name          String
  phrase        String
  note          String
  image         String
  travelTime    String                                @map("travel_time")
  crowd         String
  today         String
  fatigue       Int
  movementLevel MovementLevel                         @map("movement_level")
  moodTags      String[]                              @map("mood_tags")
  latitude      Decimal                               @db.Decimal(9, 6)
  longitude     Decimal                               @db.Decimal(9, 6)
  location      Unsupported("geometry(Point, 4326)")?
  source        String                                @default("manual")
  sourceId      String?                               @map("source_id")
  reviewStatus  PlaceReviewStatus                     @default(approved) @map("review_status")
  isActive      Boolean                               @default(true) @map("is_active")
  createdAt     DateTime                              @default(now()) @map("created_at")
  updatedAt     DateTime                              @updatedAt @map("updated_at")

  @@unique([source, sourceId])
  @@index([fatigue])
  @@index([movementLevel])
  @@index([source, reviewStatus, isActive])
  @@map("places")
}

model JournalEntry {
  id          String    @id
  ownerId     String    @map("owner_id")
  title       String
  content     String
  image       String?
  crowd       String
  placeName   String    @map("place_name")
  difficulty  String
  visitedAt   DateTime  @map("visited_at")
  publicId    String?   @unique @map("public_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, visitedAt])
  @@map("journal_entries")
}

model JournalShareTrace {
  traceId        String    @id @map("trace_id")
  shortCode      String    @unique @map("short_code")
  originUserId   String    @map("origin_user_id")
  resolvedUserId String    @map("resolved_user_id")
  entryId        String    @map("entry_id")
  imageSha256    String?   @map("image_sha256")
  signature      String?
  issuedAt       DateTime  @default(now()) @map("issued_at")
  finalizedAt    DateTime? @map("finalized_at")

  @@index([originUserId])
  @@index([resolvedUserId])
  @@index([entryId])
  @@index([issuedAt])
  @@map("journal_share_traces")
}

model User {
  id                  String               @id
  tokenHash           String               @unique @map("token_hash")
  role                UserRole             @default(user)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  authIdentities      AuthIdentity[]
  journalEntries      JournalEntry[]
  oauthAuthorizations OAuthAuthorization[]
  sessions            UserSession[]

  @@map("users")
}

model SystemLog {
  id          String   @id
  level       LogLevel @default(info)
  category    String
  action      String
  message     String
  actorUserId String?  @map("actor_user_id")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("system_logs")
}

model ContentReport {
  id             String       @id
  reporterUserId String       @map("reporter_user_id")
  entryId        String?      @map("entry_id")
  targetOwnerId  String       @map("target_owner_id")
  targetTitle    String       @map("target_title")
  targetPublicId String?      @map("target_public_id")
  reason         ReportReason
  detail         String?
  status         ReportStatus @default(pending)
  reviewerUserId String?      @map("reviewer_user_id")
  resolutionNote String?      @map("resolution_note")
  reviewedAt     DateTime?    @map("reviewed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([entryId])
  @@index([reporterUserId, createdAt])
  @@map("content_reports")
}

model AppSetting {
  key             String   @id
  value           String
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model CustomerInquiry {
  id              String          @id
  requesterUserId String?         @map("requester_user_id")
  requesterEmail  String?         @map("requester_email")
  category        InquiryCategory
  subject         String
  message         String
  status          InquiryStatus   @default(pending)
  adminResponse   String?         @map("admin_response")
  handledByUserId String?         @map("handled_by_user_id")
  handledAt       DateTime?       @map("handled_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([requesterEmail])
  @@map("customer_inquiries")
}

model AuthIdentity {
  id              String       @id
  userId          String       @map("user_id")
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model EmailVerificationCode {
  id         String    @id
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model OAuthAuthorization {
  id                  String       @id
  userId              String       @map("user_id")
  provider            AuthProvider
  stateHash           String       @unique @map("state_hash")
  codeVerifier        String       @map("code_verifier")
  returnTo            String       @default("/") @map("return_to")
  providerSubject     String?      @map("provider_subject")
  providerEmail       String?      @map("provider_email")
  completionTokenHash String?      @unique @map("completion_token_hash")
  completedAt         DateTime?    @map("completed_at")
  expiresAt           DateTime     @map("expires_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model UserSession {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
