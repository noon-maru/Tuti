generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementLevel {
  near
  short
  half
}

model Place {
  id            String                         @id
  name          String
  phrase        String
  note          String
  image         String
  travelTime    String                         @map("travel_time")
  crowd         String
  today         String
  fatigue       Int
  movementLevel MovementLevel                  @map("movement_level")
  moodTags      String[]                       @map("mood_tags")
  latitude      Decimal                        @db.Decimal(9, 6)
  longitude     Decimal                        @db.Decimal(9, 6)
  location      Unsupported("geometry(Point, 4326)")?
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")

  @@index([fatigue])
  @@index([movementLevel])
  @@map("places")
}

model JournalEntry {
  id         String   @id
  ownerId    String   @map("owner_id")
  title      String
  content    String
  image      String?
  crowd      String
  placeName  String   @map("place_name")
  difficulty String
  visitedAt  DateTime @map("visited_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, visitedAt])
  @@map("journal_entries")
}

model User {
  id             String         @id
  tokenHash      String         @unique @map("token_hash")
  email          String?        @unique
  passwordHash   String?        @map("password_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  journalEntries JournalEntry[]
  sessions       UserSession[]

  @@map("users")
}

model UserSession {
  id         String   @id
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
