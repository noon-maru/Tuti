generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementLevel {
  near
  short
  half
}

enum AuthProvider {
  email
  apple
  google
  kakao
}

model Place {
  id            String                         @id
  name          String
  phrase        String
  note          String
  image         String
  travelTime    String                         @map("travel_time")
  crowd         String
  today         String
  fatigue       Int
  movementLevel MovementLevel                  @map("movement_level")
  moodTags      String[]                       @map("mood_tags")
  latitude      Decimal                        @db.Decimal(9, 6)
  longitude     Decimal                        @db.Decimal(9, 6)
  location      Unsupported("geometry(Point, 4326)")?
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")

  @@index([fatigue])
  @@index([movementLevel])
  @@map("places")
}

model JournalEntry {
  id         String   @id
  ownerId    String   @map("owner_id")
  title      String
  content    String
  image      String?
  crowd      String
  placeName  String   @map("place_name")
  difficulty String
  visitedAt  DateTime @map("visited_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, visitedAt])
  @@map("journal_entries")
}

model User {
  id             String         @id
  tokenHash      String         @unique @map("token_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  authIdentities AuthIdentity[]
  journalEntries JournalEntry[]
  oauthAuthorizations OAuthAuthorization[]
  sessions       UserSession[]

  @@map("users")
}

model AuthIdentity {
  id              String       @id
  userId          String       @map("user_id")
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model EmailVerificationCode {
  id         String    @id
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model OAuthAuthorization {
  id                  String       @id
  userId              String       @map("user_id")
  provider            AuthProvider
  stateHash           String       @unique @map("state_hash")
  codeVerifier        String       @map("code_verifier")
  returnTo            String       @default("/") @map("return_to")
  providerSubject     String?      @map("provider_subject")
  providerEmail       String?      @map("provider_email")
  completionTokenHash String?      @unique @map("completion_token_hash")
  completedAt         DateTime?    @map("completed_at")
  expiresAt           DateTime     @map("expires_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model UserSession {
  id         String   @id
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
