# -----------------------------------------------------------------------------
# 배포 런타임 설정
# -----------------------------------------------------------------------------
# Next.js 서버를 production 모드로 실행합니다.
NODE_ENV=production

# 이메일 인증코드 기반 계정 로그인을 운영합니다.
ACCOUNT_AUTH_ENABLED=true

# 앱 이전 후 새 팀에서 공급자 구성을 마쳤으므로 소셜 OAuth를 운영합니다.
SOCIAL_OAUTH_ENABLED=true


# -----------------------------------------------------------------------------
# 배포 클라이언트 공개 설정
# -----------------------------------------------------------------------------
# 운영 웹과 Capacitor 앱 번들에 공통으로 포함되는 API base URL입니다.
# Docker build arg로도 전달되므로 배포 compose 실행 시
# --env-file .env.production을 함께 지정해야 합니다.
NEXT_PUBLIC_API_BASE_URL=https://tuti.today/api

# 공급자 검증 구현과 키 등록이 완료될 때까지 false로 유지합니다.
NEXT_PUBLIC_ACCOUNT_AUTH_ENABLED=true

# 운영 웹과 Capacitor 앱에서 소셜 로그인 영역을 표시합니다.
NEXT_PUBLIC_SOCIAL_OAUTH_ENABLED=true

# Apple OAuth 서버 설정과 키 등록을 마친 뒤에만 true로 변경합니다.
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=true

# Google OAuth 서버 설정과 키 등록을 마친 뒤에만 true로 변경합니다.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# Kakao OAuth 서버 설정과 키 등록을 마친 뒤에만 true로 변경합니다.
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=true

# 게시물 필터링·차단 체계를 갖추기 전까지 공개 웹 링크를 만들지 않습니다.
NEXT_PUBLIC_JOURNAL_PUBLICATION_ENABLED=false

# 충분한 shadow 검증 전에는 active로 변경하지 않습니다.
TUTI_PERSONALIZATION_MODE=off

# 사용자 행동을 외부 AI로 전송하는 별도 동의 기능을 마련하기 전까지 끕니다.
TUTI_USER_AI_PROFILING_ENABLED=false

# 개인정보 처리방침 개정안 시행과 운영 점검을 마치기 전까지 비활성화합니다.
FCM_PUSH_ENABLED=false

# 운영 릴리스 식별자는 배포 명령이 Git 커밋으로 자동 설정합니다.
TUTI_RELEASE=unknown


# -----------------------------------------------------------------------------
# 배포 서버 DB 연결
# -----------------------------------------------------------------------------
# app 컨테이너에서 Compose의 db 서비스로 접근하는 Prisma 연결 주소입니다.
DATABASE_URL=postgresql://tuti_user:tuti_password@db:5432/tuti?schema=public


# -----------------------------------------------------------------------------
# 배포 DB 컨테이너 초기화
# -----------------------------------------------------------------------------
# PostGIS PostgreSQL 컨테이너가 최초 생성될 때 사용할 계정과 DB 이름입니다.
# 실제 배포 환경에서는 POSTGRES_PASSWORD를 반드시 교체하세요.
POSTGRES_USER=tuti_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuti
