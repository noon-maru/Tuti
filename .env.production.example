# =============================================================================
# Tuti 운영 환경변수 예시
# =============================================================================
# 이 파일은 `.env`의 공통 설정 중 운영에서 별도로 덮어쓸 값만 담습니다.
# 비밀번호, API 키 및 비밀키 원문은 Git에 커밋하지 않습니다. Docker Compose는
# `.env` 다음에 `.env.production`을 읽으므로 이 파일의 값이 우선합니다.


# -----------------------------------------------------------------------------
# 운영 런타임
# -----------------------------------------------------------------------------
# Next.js 서버를 production 모드로 실행합니다.
NODE_ENV=production

# 운영 릴리스 식별자는 배포 명령이 Git 커밋 해시로 자동 설정합니다.
TUTI_RELEASE=unknown


# -----------------------------------------------------------------------------
# 인증·공개 기능 서버 설정
# -----------------------------------------------------------------------------
# 이메일 인증코드 기반 계정 로그인을 운영합니다.
ACCOUNT_AUTH_ENABLED=true

# 모든 소셜 OAuth를 일괄 활성화합니다. 공급자별 서버 설정과 키가 먼저
# `.env` 또는 이 파일에 준비되어 있어야 합니다.
SOCIAL_OAUTH_ENABLED=true


# -----------------------------------------------------------------------------
# 위치정보 보호·외부 좌표 처리
# -----------------------------------------------------------------------------
# 위치정보 이용·제공 기록의 HMAC 무결성 서명에 사용하는 서버 전용 비밀값입니다.
# 개발 기록과 운영 기록의 서명키를 분리하기 위해 운영에서 반드시 덮어씁니다.
# 이미 운영 중인 값은 과거 감사기록 검증을 위해 교체하지 않습니다.
LOCATION_AUDIT_HMAC_SECRET=replace-with-at-least-32-random-characters


# -----------------------------------------------------------------------------
# 클라이언트 공개 설정
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ 값은 운영 웹과 Capacitor 앱 번들에 공개됩니다.
# 비밀번호나 비밀키를 절대로 NEXT_PUBLIC_ 변수에 넣지 마세요.

# 운영 웹과 Capacitor 앱이 사용할 API 기준 주소입니다.
# Docker build arg로도 전달되므로 Compose 실행 시 반드시
# `--env-file .env.production`을 지정합니다.
NEXT_PUBLIC_API_BASE_URL=https://tuti.today/api

# 로그인 UI 및 공급자별 버튼 노출 여부입니다.
NEXT_PUBLIC_ACCOUNT_AUTH_ENABLED=true
NEXT_PUBLIC_SOCIAL_OAUTH_ENABLED=true
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=true

# 게시물 필터링·차단 체계를 갖추기 전까지 공개 웹 링크를 생성하지 않습니다.
NEXT_PUBLIC_JOURNAL_PUBLICATION_ENABLED=false
# 첫 내부 검증은 internal, 정식 제공 시 public로 변경
NEXT_PUBLIC_JOURNAL_PUBLICATION_AUDIENCE=internal


# -----------------------------------------------------------------------------
# 추천 개인화·외부 AI 처리
# -----------------------------------------------------------------------------
# off: 미사용, shadow: 결과만 기록, active: 추천 순위에 반영
# 충분한 shadow 검증 전에는 active로 변경하지 않습니다.
TUTI_PERSONALIZATION_MODE=off

# 사용자 행동을 외부 AI로 전송하는 별도 동의 기능을 마련하기 전까지 끕니다.
TUTI_USER_AI_PROFILING_ENABLED=false


# -----------------------------------------------------------------------------
# Android 서버 푸시 · Firebase Cloud Messaging
# -----------------------------------------------------------------------------
# 개인정보 처리방침 시행 및 운영 점검 전에는 전체 발송을 비활성화합니다.
FCM_PUSH_ENABLED=false

# 전체 활성화 전 알림을 시험할 내부 계정 이메일입니다. 여러 계정은 쉼표로
# 구분합니다. 이 값이 있으면 FCM_PUSH_ENABLED=false 상태에서도 해당 계정의
# 기기 등록과 발송만 허용됩니다.
FCM_PUSH_TEST_EMAILS=


# -----------------------------------------------------------------------------
# iOS 서버 푸시 · Apple Push Notification service
# -----------------------------------------------------------------------------
# 개인정보 처리방침 시행 및 운영 점검 전에는 전체 발송을 비활성화합니다.
APNS_PUSH_ENABLED=false

# 전체 활성화 전 알림을 시험할 내부 계정 이메일입니다. 여러 계정은 쉼표로
# 구분합니다. 이 값이 있으면 APNS_PUSH_ENABLED=false 상태에서도 해당 계정의
# 기기 등록과 발송만 허용됩니다.
APNS_PUSH_TEST_EMAILS=

# Apple Developer Membership에 표시되는 현재 소유자 팀의 Team ID입니다.
APNS_TEAM_ID=replace-with-apple-team-id

# 내려받은 `AuthKey_XXXXXXXXXX.p8` 파일명의 XXXXXXXXXX 부분입니다.
APNS_KEY_ID=replace-with-apns-key-id

# iOS 앱의 Bundle ID와 정확히 일치해야 합니다.
APNS_BUNDLE_ID=com.noonmaru.tuti

# Xcode 직접 설치 개발 빌드는 sandbox, TestFlight·App Store는 production입니다.
APNS_ENVIRONMENT=production

# APNs .p8 키는 저장소와 Docker 이미지 밖에 보관하고 호스트 경로만 지정합니다.
APNS_PRIVATE_KEY_HOST_PATH=/var/services/homes/Tutiadmin/.tuti-secrets/apple/tuti-apns-auth-key.p8


# -----------------------------------------------------------------------------
# 운영 애플리케이션 DB 연결
# -----------------------------------------------------------------------------
# app 컨테이너에서 Compose의 db 서비스로 접근하는 Prisma 연결 주소입니다.
# 아래 사용자명·비밀번호·DB 이름을 POSTGRES_* 값과 동일하게 맞춥니다.
DATABASE_URL=postgresql://tuti_user:change-me@db:5432/tuti?schema=public


# -----------------------------------------------------------------------------
# 운영 PostgreSQL 컨테이너 초기화
# -----------------------------------------------------------------------------
# DB 볼륨이 최초 생성될 때 사용하는 값입니다. 기존 볼륨이 있다면 이 값을
# 바꾸는 것만으로 실제 DB 계정 비밀번호가 자동 변경되지는 않습니다.
POSTGRES_USER=tuti_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuti
