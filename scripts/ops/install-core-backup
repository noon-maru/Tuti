#!/bin/sh
set -eu
PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
export PATH
resume_id=""
case "$#:$*" in
  0:) apply=false ;;
  1:--apply) apply=true ;;
  2:--resume-verified\ *)
    apply=true; resume_id="$2"
    if ! printf '%s\n' "$resume_id" | LC_ALL=C grep -Eq '^[0-9]{8}-[0-9]{6}$'; then exit 1; fi
    ;;
  *) echo "사용법: sudo sh scripts/ops/install-core-backup [--apply | --resume-verified YYYYMMDD-HHMMSS]" >&2; exit 1 ;;
esac
project_dir=/var/services/homes/Tutiadmin/source/Tuti
project_dir="$(CDPATH= cd -- "$project_dir" && pwd -P)"
cd "$project_dir"
sources="scripts/ops/install-core-backup scripts/ops/tuti-prod-backup scripts/ops/tuti-prod-backup-prune scripts/ops/tuti-prod-restore scripts/ops/tuti-prod-backup-verify scripts/verify-production-backup.ts src/server/legal/backupVerification.ts scripts/ops/core-backup-production-guard.sql scripts/ops/core-backup-excluded-data-tables.txt scripts/prune-production-backups.ts src/server/legal/backupRetention.ts scripts/ops/systemd/tuti-core-backup.service scripts/ops/systemd/tuti-core-backup.timer"
for source in $sources; do
  git -c safe.directory="$project_dir" ls-files --error-unmatch "$source" >/dev/null 2>&1
  git -c safe.directory="$project_dir" diff --quiet HEAD -- "$source"
done
if [ "$apply" != true ]; then echo "핵심 백업 설치 원본 확인 완료. --apply에서만 설치·첫 백업·예약 활성화를 수행합니다."; exit 0; fi
if [ "$(id -u)" != 0 ]; then echo "root 권한이 필요합니다." >&2; exit 1; fi
command -v curl >/dev/null
if [ "$(date +%z)" != +0900 ]; then echo "일일 예약은 NAS 시간대가 한국 표준시(+0900)일 때만 활성화합니다." >&2; exit 1; fi
if ! systemctl is-active --quiet tuti-backup-retention.timer || ! systemctl is-enabled --quiet tuti-backup-retention.timer; then
  echo "기존 30일 백업 정리 타이머가 활성·부팅 예약 상태여야 합니다." >&2; exit 1
fi
# 기존 전체 백업 예약과 개인정보 타이머는 변경하지 않는다.
for name in tuti-prod-backup tuti-prod-backup-prune tuti-prod-restore; do
  if [ -L "/usr/local/sbin/$name" ]; then exit 1; fi
done
for unit in tuti-core-backup.service tuti-core-backup.timer; do
  if [ -L "/etc/systemd/system/$unit" ]; then exit 1; fi
done
if [ -L /volume1/tuti/backups/core ]; then exit 1; fi
install -d -o root -g root -m 0700 /volume1/tuti/backups/core "$project_dir/.ops-state"
exec 9>"$project_dir/.ops-state/maintenance.lock"
/usr/bin/flock --exclusive --nonblock 9 || { echo "유지보수 종료 후 다시 실행해주세요." >&2; exit 1; }
if [ -f .ops-state/restore-privacy/pending.env ] || [ -f .ops-state/privacy-activation/pending ]; then exit 1; fi
snapshot="$project_dir/.ops-state/core-tools/$(date +%Y%m%d-%H%M%S)-$$"
install -d -o root -g root -m 0700 "$snapshot"
systemctl stop tuti-core-backup.timer 2>/dev/null || true
for name in tuti-prod-backup tuti-prod-backup-prune tuti-prod-restore; do
  if [ -f "/usr/local/sbin/$name" ]; then cp -p "/usr/local/sbin/$name" "$snapshot/$name"; fi
  install -o root -g root -m 0750 "scripts/ops/$name" "/usr/local/sbin/$name"
done
for unit in tuti-core-backup.service tuti-core-backup.timer; do
  if [ -f "/etc/systemd/system/$unit" ]; then cp -p "/etc/systemd/system/$unit" "$snapshot/$unit"; fi
  install -o root -g root -m 0644 "scripts/ops/systemd/$unit" "/etc/systemd/system/$unit"
done
systemctl daemon-reload
/usr/bin/flock --unlock 9
# 원장·두 경로를 실제 삭제 없이 검증한 뒤 첫 핵심 백업을 생성한다.
/usr/local/sbin/tuti-prod-backup-prune
set --
if [ -z "$resume_id" ]; then
  systemctl start tuti-core-backup.service
else
  # 이미 생성한 사본을 다시 검증하며 앱 중지·새 백업 생성은 하지 않는다.
  set -- "$resume_id"
fi
sh scripts/ops/tuti-prod-backup-verify --core "$@"
ready=false
attempt=1
while [ "$attempt" -le 12 ]; do
  # Docker CLI를 별도 timeout 프로세스 그룹으로 옮기면 대화형 NAS 터미널에서
  # SIGTTIN으로 정지할 수 있다. 공개 포트의 동일 readiness를 curl 자체 제한으로 검사한다.
  if curl --fail --silent --show-error --connect-timeout 3 --max-time 8 \
    http://127.0.0.1:5050/api/health </dev/null >/dev/null 2>&1; then
    ready=true; break
  fi
  sleep 5
  attempt=$((attempt + 1))
done
if [ "$ready" != true ]; then echo "첫 백업 후 앱 readiness를 확인하지 못했습니다. 새 백업 예약은 켜지 않았습니다." >&2; exit 1; fi
# 첫 사본 무결성 통과 후에만 예약을 켠다. 기존 systemd에는 --now가 없다.
systemctl enable tuti-core-backup.timer
systemctl start tuti-core-backup.timer
systemctl is-active tuti-core-backup.timer
echo "핵심 일일 백업 활성화 완료. 전체 백업 예약 유지, 두 종류 모두 30일 보관 정리 대상입니다."
