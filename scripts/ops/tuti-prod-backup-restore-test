#!/bin/sh
set -eu
PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
export PATH
if [ "$(id -u)" != 0 ] || [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "사용법: sudo sh scripts/ops/tuti-prod-backup-restore-test YYYYMMDD-HHMMSS [--profile|--core-test]" >&2; exit 1
fi
profile=false
core_test=false
case "${2:-}" in "") ;; --profile) profile=true ;; --core-test) core_test=true ;; *) exit 1 ;; esac
backup_id="$1"
if ! printf '%s\n' "$backup_id" | LC_ALL=C grep -Eq '^[0-9]{8}-[0-9]{6}$'; then exit 1; fi
project_dir="/var/services/homes/Tutiadmin/source/Tuti"
backup_root="/volume1/tuti/backups/full"
disk_root="/volume1/tuti/restore-tests"
backup_dir="$backup_root/$backup_id"
cd "$project_dir"
for source in scripts/ops/tuti-prod-backup-restore-test scripts/ops/isolated-restore-garage.toml scripts/ops/isolated-restore-observations.sql scripts/ops/isolated-restore-progress.sql scripts/verify-isolated-production-restore.ts src/server/legal/isolatedRestoreVerification.ts; do
  git -c safe.directory="$project_dir" ls-files --error-unmatch "$source" >/dev/null 2>&1
  git -c safe.directory="$project_dir" diff --quiet HEAD -- "$source"
done
if [ "$core_test" = true ]; then
  for source in scripts/ops/core-backup-excluded-data-tables.txt scripts/ops/core-backup-snapshot.sql scripts/compare-core-restore.ts src/server/legal/coreRestoreComparison.ts; do
    git -c safe.directory="$project_dir" ls-files --error-unmatch "$source" >/dev/null 2>&1
    git -c safe.directory="$project_dir" diff --quiet HEAD -- "$source"
  done
  if [ "$(wc -l < scripts/ops/core-backup-excluded-data-tables.txt | tr -d ' ')" != 12 ] || \
    LC_ALL=C grep -qvE '^[a-z_]+$' scripts/ops/core-backup-excluded-data-tables.txt; then exit 1; fi
fi
if [ ! -d "$backup_dir" ] || [ -L "$backup_dir" ] || [ -L "$backup_root" ]; then exit 1; fi
# 유지보수와 겹치거나 복구 확인 대기 중이면 실행하지 않는다. 운영 서비스는 정지하지 않는다.
exec 9>"$project_dir/.ops-state/maintenance.lock"
/usr/bin/flock --shared --nonblock 9 || { echo "다른 유지보수 작업이 실행 중입니다." >&2; exit 1; }
exec 8>"$project_dir/.ops-state/isolated-restore.lock"
/usr/bin/flock --exclusive --nonblock 8 || { echo "다른 격리 복원 시험이 실행 중입니다." >&2; exit 1; }
if [ -f .ops-state/restore-privacy/pending.env ] || [ -f .ops-state/privacy-activation/pending ]; then exit 1; fi
command -v timeout >/dev/null
available_kb="$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)"
if [ "$profile" = true ]; then
  if [ "${available_kb:-0}" -lt 524288 ]; then echo "조회에 필요한 여유 메모리가 부족합니다." >&2; exit 1; fi
else
  if [ "${available_kb:-0}" -lt 4194304 ]; then echo "사용 가능 메모리 4GiB 이상에서만 실행합니다." >&2; exit 1; fi
  if [ -L "$disk_root" ]; then exit 1; fi
  if [ -e "$disk_root" ]; then
    if [ ! -d "$disk_root" ] || [ "$(stat -c '%u:%a' "$disk_root")" != "0:700" ]; then echo "시험 디렉터리의 root 전용 권한 확인이 필요합니다." >&2; exit 1; fi
  else mkdir -m 0700 "$disk_root"; fi
  available_disk_kb="$(df -Pk "$disk_root" | awk 'NR == 2 { print $4 }')"
  if [ "${available_disk_kb:-0}" -lt 67108864 ]; then echo "시험 볼륨의 여유 공간 64GiB 이상이 필요합니다." >&2; exit 1; fi
fi
for image in tuti:ops postgis/postgis:17-3.5 dxflrs/garage:v2.3.0; do
  docker image inspect "$image" >/dev/null
  volumes="$(docker image inspect --format '{{range $key, $value := .Config.Volumes}}{{println $key}}{{end}}' "$image")"
  for volume in $volumes; do
    case "$image:$volume" in
      postgis/postgis:17-3.5:/var/lib/postgresql/data | dxflrs/garage:v2.3.0:/var/lib/garage | dxflrs/garage:v2.3.0:/var/lib/garage/meta | dxflrs/garage:v2.3.0:/var/lib/garage/data) ;;
      *) echo "예상하지 못한 이미지 볼륨 선언입니다. 시험을 시작하지 않습니다." >&2; exit 1 ;;
    esac
  done
done
if [ "$(docker info --format '{{.MemoryLimit}}')" != true ]; then echo "메모리 제한이 필요합니다." >&2; exit 1; fi
cpu_quota="$(docker info --format '{{.CPUCfsQuota}}')"
pids_limit="$(docker info --format '{{.PidsLimit}}')"
limits() {
  memory="$1"; shift
  if [ "$cpu_quota" = true ]; then set -- --cpus 0.5 "$@"; fi
  if [ "$pids_limit" = true ]; then set -- --pids-limit 128 "$@"; fi
  timeout 240 docker run --read-only --memory "$memory" --cap-drop ALL --security-opt no-new-privileges:true --log-driver none "$@"
}
if [ "$profile" = true ]; then
  # TOC는 표준 출력 파이프 안에서 집계만 한다. 테이블명·본문·실제 데이터는 출력하지 않는다.
  if ! limits 128m --rm --network none -v "$backup_dir:/backup:ro" \
    --entrypoint bash postgis/postgis:17-3.5 -o pipefail -c '
      set -eu
      size=$(stat -c %s /backup/postgres.dump)
      printf "{\"scope\":\"backup-archive-profile-only\",\"archiveBytes\":%s,\"restorePerformed\":false}\n" "$size"
      pg_restore --list /backup/postgres.dump | awk '\''
        / TABLE DATA / { data++ }
        / INDEX / { indexes++ }
        / FK CONSTRAINT / { foreign_keys++ }
        END { printf "{\"tableDataEntries\":%d,\"indexEntries\":%d,\"foreignKeyEntries\":%d,\"identifiersSuppressed\":true}\n", data, indexes, foreign_keys }
      '\''
    ' 2>/dev/null; then echo "백업 구조 조회에 실패했습니다. 복원은 실행하지 않았습니다." >&2; exit 1; fi
  exit 0
fi
# 원본 파일 검증이 실패하면 사본을 복원하지 않는다.
sh scripts/ops/tuti-prod-backup-verify "$backup_id"
umask 077
scratch="$(mktemp -d /dev/shm/tuti-restore-test.XXXXXXXX)"
db_scratch=""
disk_monitor_pid=""
test_id="tuti-restore-test-$(date +%s)-$$"
pg_name="$test_id-pg"
garage_name="$test_id-garage"
node_name="$test_id-node"
stage="sandbox-start"
cleanup() {
  result="$?"
  trap - EXIT INT TERM
  case "$stage:$result" in
    core-*:0) ;;
    core-*:*)
      core_failure_reason=CORE_STAGE_FAILED
      for private_log in "$scratch/core-source.log" "$scratch/core-dump.log" "$scratch/core-create.log" "$scratch/core-restore.log" "$scratch/core-restored.log"; do
        if [ ! -f "$private_log" ]; then continue; fi
        if LC_ALL=C grep -q 'CORE_POLICY_TABLE_MISSING' "$private_log"; then core_failure_reason=CORE_POLICY_TABLE_MISSING; break
        elif LC_ALL=C grep -q 'CORE_DEPENDENCY_BLOCKED' "$private_log"; then core_failure_reason=CORE_DEPENDENCY_BLOCKED; break
        elif LC_ALL=C grep -qi 'syntax error' "$private_log"; then core_failure_reason=CORE_SQL_SYNTAX_ERROR; break
        elif LC_ALL=C grep -qi 'permission denied' "$private_log"; then core_failure_reason=CORE_PERMISSION_ERROR; break
        elif LC_ALL=C grep -qi 'statement timeout' "$private_log"; then core_failure_reason=CORE_QUERY_TIMEOUT; break
        elif LC_ALL=C grep -qi 'does not exist' "$private_log"; then core_failure_reason=CORE_DB_OBJECT_MISSING; break
        fi
      done
      printf '{"stage":"%s","reason":"%s","privateDetailsSuppressed":true}\n' "$stage" "$core_failure_reason" >&2
      ;;
  esac
  cleanup_ok=true
  if [ -n "$disk_monitor_pid" ]; then kill "$disk_monitor_pid" 2>/dev/null || true; wait "$disk_monitor_pid" 2>/dev/null || true; fi
  for container in "$node_name" "$garage_name" "$pg_name"; do
    if docker container inspect "$container" >/dev/null 2>&1; then
      owner="$(docker container inspect --format '{{index .Config.Labels "tuti.restore-test"}}' "$container")"
      if [ "$owner" != "$test_id" ] || ! docker rm --force --volumes "$container" >/dev/null 2>&1; then cleanup_ok=false; fi
    fi
  done
  if [ "$cleanup_ok" = true ] && [ -n "$db_scratch" ]; then
    case "$db_scratch" in "$disk_root"/run.*) if [ ! -L "$db_scratch" ]; then if ! rm -r -- "$db_scratch"; then cleanup_ok=false; fi; else cleanup_ok=false; fi ;; *) cleanup_ok=false ;; esac
  fi
  if [ "$cleanup_ok" = true ]; then
    case "$scratch" in /dev/shm/tuti-restore-test.*) if [ ! -L "$scratch" ]; then if ! rm -r -- "$scratch"; then cleanup_ok=false; fi; else cleanup_ok=false; fi ;; *) cleanup_ok=false ;; esac
  fi
  if [ "$cleanup_ok" != true ]; then echo "시험용 자원 정리 확인이 필요합니다: $test_id" >&2; exit 1; fi
  printf '{"sandboxId":"%s","sandboxResourcesRemoved":true,"productionRestorePerformed":false}\n' "$test_id"
  if [ "$result" != 0 ]; then printf '{"stage":"%s","status":"failed","privateDetailsSuppressed":true}\n' "$stage" >&2; fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
pg_uid="$(limits 128m --rm --network none --entrypoint id postgis/postgis:17-3.5 -u postgres)"
pg_gid="$(limits 128m --rm --network none --entrypoint id postgis/postgis:17-3.5 -g postgres)"
case "$pg_uid:$pg_gid" in *[!0-9:]* | :*) exit 1 ;; esac
install -d -m 0700 -o "$pg_uid" -g "$pg_gid" "$scratch/pglogs"
db_scratch="$(mktemp -d "$disk_root/run.XXXXXXXX")"
install -d -m 0700 -o "$pg_uid" -g "$pg_gid" "$db_scratch/data"
set --
if [ "$core_test" = true ]; then
  set -- -v "$db_scratch:/sandbox-work" -v "$project_dir/scripts/ops/core-backup-excluded-data-tables.txt:/sandbox-policy/excluded.txt:ro"
fi
limits 1536m --detach --name "$pg_name" --label "tuti.restore-test=$test_id" --network none --user postgres --shm-size 256m \
  -v "$db_scratch/data:/var/lib/postgresql/data" \
  "$@" \
  -v "$backup_dir/postgres.dump:/backup/postgres.dump:ro" \
  --tmpfs "/var/run/postgresql:rw,nosuid,nodev,size=16m,uid=$pg_uid,gid=$pg_gid,mode=0775" \
  --tmpfs /tmp:rw,nosuid,nodev,size=32m \
  -v "$scratch/pglogs:/sandbox-logs" \
  -e POSTGRES_DB=postgres -e POSTGRES_HOST_AUTH_METHOD=trust \
  postgis/postgis:17-3.5 postgres -c listen_addresses= -c unix_socket_directories=/var/run/postgresql \
  -c shared_buffers=128MB -c max_connections=8 -c maintenance_work_mem=128MB \
  -c max_parallel_maintenance_workers=0 -c max_wal_size=1GB -c min_wal_size=128MB -c logging_collector=on \
  -c log_directory=/sandbox-logs -c log_filename=postgres.log -c log_error_verbosity=terse \
  -c log_min_error_statement=panic >/dev/null
# 32GiB는 주기적 감시 임계값이며 파일시스템의 강제 quota는 아니다. 운영 파일은 감시·정리하지 않는다.
(
  trap - EXIT INT TERM
  progress_tick=0
  while [ "$(docker container inspect --format '{{.State.Running}}' "$pg_name" 2>/dev/null)" = true ]; do
    used_kb="$(du -sk "$db_scratch/data" 2>/dev/null | awk '{ print $1 }')"
    free_kb="$(df -Pk "$disk_root" | awk 'NR == 2 { print $4 }')"
    if [ "${used_kb:-0}" -gt 33554432 ] || [ "${free_kb:-0}" -lt 4194304 ]; then
      : > "$scratch/disk-limit"
      if [ "$(docker container inspect --format '{{index .Config.Labels "tuti.restore-test"}}' "$pg_name")" = "$test_id" ]; then docker kill "$pg_name" >/dev/null 2>&1 || true; fi
      exit 0
    fi
    progress_tick=$((progress_tick + 1))
    if [ -f "$scratch/restore-active" ] && [ "$progress_tick" -ge 15 ]; then
      progress_tick=0
      monitor_db=restore_test
      if [ -f "$scratch/core-active" ]; then monitor_db=core_restore_test; fi
      if timeout 10 docker exec -i "$pg_name" psql --host /var/run/postgresql --port 5432 --no-psqlrc -q -U postgres -d "$monitor_db" -At -v ON_ERROR_STOP=1 \
        < "$project_dir/scripts/ops/isolated-restore-progress.sql" > "$scratch/progress.json" 2>/dev/null; then
        cat "$scratch/progress.json"
      fi
    fi
    sleep 2
  done
) &
disk_monitor_pid="$!"
limits 384m --detach --name "$garage_name" --label "tuti.restore-test=$test_id" --network none \
  --tmpfs /var/lib/garage:rw,nosuid,nodev,size=8m \
  --tmpfs /var/lib/garage/meta:rw,nosuid,nodev,size=64m \
  --tmpfs /var/lib/garage/data:rw,nosuid,nodev,size=256m --tmpfs /tmp:rw,nosuid,nodev,size=16m \
  -v "$project_dir/scripts/ops/isolated-restore-garage.toml:/etc/garage.toml:ro" \
  -e GARAGE_RPC_SECRET=1111111111111111111111111111111111111111111111111111111111111111 \
  -e GARAGE_ADMIN_TOKEN=isolated-restore-test -e GARAGE_METRICS_TOKEN=isolated-restore-test \
  -e GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef01234567 \
  -e GARAGE_DEFAULT_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222 \
  -e GARAGE_DEFAULT_BUCKET=tuti-restore-test \
  dxflrs/garage:v2.3.0 /garage server --single-node --default-bucket >/dev/null
attempt=0
until docker exec "$pg_name" sh -c 'test "$(cat /proc/1/comm)" = postgres && pg_isready -h /var/run/postgresql -p 5432 -U postgres -d postgres' >/dev/null 2>&1 && docker exec "$garage_name" /garage status >/dev/null 2>&1; do
  attempt=$((attempt + 1)); if [ "$attempt" -ge 30 ]; then exit 1; fi; sleep 2
done
stage="isolated-archive-access"
server_user_can_read=false
if docker exec "$pg_name" test -r /backup/postgres.dump >/dev/null 2>&1; then server_user_can_read=true; fi
if ! docker exec --user 0:0 "$pg_name" test -r /backup/postgres.dump >/dev/null 2>&1; then
  echo '{"stage":"isolated-archive-access","reason":"ARCHIVE_READ_PERMISSION_DENIED"}' >&2; exit 1
fi
printf '{"stage":"isolated-archive-access","serverUserCanReadArchive":%s,"restoreClientUser":"root","databaseRole":"postgres","archiveAccessMode":"read-only-bind"}\n' "$server_user_can_read"
stage="isolated-empty-database"
if ! timeout 30 docker exec "$pg_name" createdb --host /var/run/postgresql --port 5432 --username postgres --template template0 restore_test > "$scratch/create.log" 2>&1; then exit 1; fi
stage="isolated-postgres-restore"
restore_started_at="$(date +%s)"
restore_deadline=$((restore_started_at + 1800))
: > "$scratch/restore-active"
for restore_section in pre-data data post-data; do
  remaining_seconds=$((restore_deadline - $(date +%s)))
  if [ "$remaining_seconds" -le 0 ]; then echo '{"stage":"isolated-postgres-restore","reason":"RESTORE_TIMEOUT"}' >&2; exit 1; fi
  jobs=2
  if [ "$restore_section" = pre-data ]; then jobs=1; fi
  section_started_at="$(date +%s)"
  printf '{"stage":"isolated-postgres-restore","section":"%s","status":"started","jobs":%s}\n' "$restore_section" "$jobs"
# 원본은 root 전용이다. 권한을 풀거나 복사하지 않고 클라이언트만 컨테이너 root로 실행한다.
# 서버 UID·접속 DB 역할은 postgres 그대로이며 cap-drop ALL·읽기 전용 마운트를 유지한다.
if timeout "$remaining_seconds" docker exec --user 0:0 "$pg_name" pg_restore --host /var/run/postgresql --port 5432 --username postgres --dbname restore_test --no-owner --no-privileges --exit-on-error \
  --section "$restore_section" --jobs "$jobs" /backup/postgres.dump > "$scratch/restore.log" 2>&1; then
  section_elapsed=$(( $(date +%s) - section_started_at ))
  printf '{"stage":"isolated-postgres-restore","section":"%s","status":"completed","elapsedSeconds":%s}\n' "$restore_section" "$section_elapsed"
else
  restore_status="$?"
  docker container inspect --format '{"stage":"isolated-postgres-status","running":{{.State.Running}},"oomKilled":{{.State.OOMKilled}},"exitCode":{{.State.ExitCode}}}' "$pg_name" > "$scratch/state.json" 2>/dev/null || true
  if [ -s "$scratch/state.json" ]; then cat "$scratch/state.json" >&2; fi
  if docker exec "$pg_name" df -Pk /var/lib/postgresql/data /dev/shm > "$scratch/disk.tsv" 2>/dev/null; then
    awk 'NR > 1 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ { printf "{\"stage\":\"isolated-postgres-capacity\",\"storageIndex\":%d,\"totalKiB\":%s,\"usedKiB\":%s,\"availableKiB\":%s}\n", NR-1, $2, $3, $4 }' "$scratch/disk.tsv" >&2
  fi
  # 원문·테이블명·행 내용은 출력하지 않고 정적인 오류 분류만 남긴다.
  matches_restore_error() { LC_ALL=C grep -qi "$1" "$scratch/restore.log" "$scratch/pglogs/postgres.log" 2>/dev/null; }
  restore_reason=UNCLASSIFIED_RESTORE_ERROR
  if [ -f "$scratch/disk-limit" ]; then restore_reason=SANDBOX_DISK_BUDGET_EXCEEDED
  elif [ "$restore_status" = 124 ]; then restore_reason=RESTORE_TIMEOUT
  elif LC_ALL=C grep -q '"oomKilled":true' "$scratch/state.json" 2>/dev/null || matches_restore_error 'out of memory\|Cannot allocate memory'; then restore_reason=SANDBOX_MEMORY_EXHAUSTED
  elif matches_restore_error 'could not resize shared memory segment'; then restore_reason=SANDBOX_SHARED_MEMORY_EXHAUSTED
  elif matches_restore_error 'No space left on device'; then restore_reason=SANDBOX_SPACE_EXHAUSTED
  elif matches_restore_error 'already exists'; then restore_reason=DATABASE_OBJECT_ALREADY_EXISTS
  elif matches_restore_error 'database .* does not exist'; then restore_reason=SANDBOX_DATABASE_MISSING
  elif matches_restore_error 'password authentication failed\|no pg_hba.conf entry\|Peer authentication failed'; then restore_reason=SANDBOX_AUTHENTICATION_FAILED
  elif matches_restore_error 'remaining connection slots\|too many clients'; then restore_reason=SANDBOX_CONNECTION_LIMIT
  elif matches_restore_error 'No such file or directory\|Connection refused'; then restore_reason=SANDBOX_SOCKET_UNAVAILABLE
  elif matches_restore_error 'could not open input file.*[Pp]ermission denied'; then restore_reason=ARCHIVE_READ_PERMISSION_DENIED
  elif matches_restore_error 'permission denied\|must be owner\|must be superuser'; then restore_reason=DATABASE_PERMISSION_ERROR
  elif matches_restore_error 'extension.*not available\|could not open extension\|could not access file'; then restore_reason=EXTENSION_UNAVAILABLE
  elif matches_restore_error 'unsupported version\|invalid archive\|unexpected end of file'; then restore_reason=ARCHIVE_RESTORE_FORMAT_ERROR
  elif matches_restore_error 'unrecognized configuration parameter'; then restore_reason=DATABASE_SETTING_UNSUPPORTED
  elif matches_restore_error 'duplicate key value'; then restore_reason=DUPLICATE_DATA
  elif matches_restore_error 'server closed the connection\|terminating connection\|connection.*closed\|connection.*failed'; then restore_reason=DATABASE_CONNECTION_INTERRUPTED
  fi
  printf '{"stage":"isolated-postgres-restore","section":"%s","reason":"%s","exitStatus":%s,"privateDetailsSuppressed":true}\n' "$restore_section" "$restore_reason" "$restore_status" >&2
  exit 1
fi
done
rm "$scratch/restore-active"
printf '{"stage":"isolated-postgres-restore","status":"completed","elapsedSeconds":%s}\n' "$(( $(date +%s) - restore_started_at ))"
restore_db=restore_test
if [ "$core_test" = true ]; then
  core_started_at="$(date +%s)"
  stage="core-source-snapshot"
  printf '{"stage":"core-source-snapshot","status":"started"}\n'
  if ! timeout 150 docker exec -i --user 0:0 "$pg_name" psql --host /var/run/postgresql --port 5432 --no-psqlrc -q -U postgres -d restore_test -At -v ON_ERROR_STOP=1 \
    < scripts/ops/core-backup-snapshot.sql > "$scratch/core-source.json" 2> "$scratch/core-source.log"; then exit 1; fi
  stage="core-dump-create"
  core_dump_started_at="$(date +%s)"
  printf '{"stage":"core-dump-create","status":"started","source":"isolated-full-snapshot"}\n'
  if ! timeout 300 docker exec --user 0:0 "$pg_name" sh -c '
    set -eu
    set --
    while IFS= read -r table; do set -- "$@" "--exclude-table-data=public.$table"; done < /sandbox-policy/excluded.txt
    exec pg_dump --host /var/run/postgresql --port 5432 --username postgres --dbname restore_test \
      --format=custom --compress=6 --no-owner --no-privileges --file=/sandbox-work/core.dump "$@"
  ' > "$scratch/core-dump.log" 2>&1; then exit 1; fi
  core_archive_bytes="$(stat -c %s "$db_scratch/core.dump")"
  printf '{"stage":"core-dump-create","status":"completed","archiveBytes":%s,"elapsedSeconds":%s}\n' "$core_archive_bytes" "$(( $(date +%s) - core_dump_started_at ))"
  stage="core-database-create"
  if ! timeout 30 docker exec "$pg_name" createdb --host /var/run/postgresql --port 5432 --username postgres --template template0 core_restore_test \
    > "$scratch/core-create.log" 2>&1; then exit 1; fi
  core_restore_started_at="$(date +%s)"
  core_deadline=$((core_restore_started_at + 600))
  : > "$scratch/core-active"
  : > "$scratch/restore-active"
  for core_section in pre-data data post-data; do
    stage="core-database-restore-$core_section"
    core_remaining=$((core_deadline - $(date +%s)))
    if [ "$core_remaining" -le 0 ]; then exit 1; fi
    core_jobs=2
    if [ "$core_section" = pre-data ]; then core_jobs=1; fi
    core_section_started_at="$(date +%s)"
    printf '{"stage":"core-database-restore","section":"%s","status":"started"}\n' "$core_section"
    if ! timeout "$core_remaining" docker exec --user 0:0 "$pg_name" pg_restore --host /var/run/postgresql --port 5432 --username postgres --dbname core_restore_test \
      --no-owner --no-privileges --exit-on-error --section "$core_section" --jobs "$core_jobs" /sandbox-work/core.dump \
      > "$scratch/core-restore.log" 2>&1; then exit 1; fi
    printf '{"stage":"core-database-restore","section":"%s","status":"completed","elapsedSeconds":%s}\n' "$core_section" "$(( $(date +%s) - core_section_started_at ))"
  done
  rm "$scratch/restore-active"
  rm "$scratch/core-active"
  printf '{"stage":"core-database-restore","status":"completed","elapsedSeconds":%s}\n' "$(( $(date +%s) - core_restore_started_at ))"
  stage="core-restored-snapshot"
  printf '{"stage":"core-restored-snapshot","status":"started"}\n'
  if ! timeout 150 docker exec -i --user 0:0 "$pg_name" psql --host /var/run/postgresql --port 5432 --no-psqlrc -q -U postgres -d core_restore_test -At -v ON_ERROR_STOP=1 \
    < scripts/ops/core-backup-snapshot.sql > "$scratch/core-restored.json" 2> "$scratch/core-restored.log"; then exit 1; fi
  stage="core-row-fingerprint-comparison"
  if ! limits 384m --rm --name "$node_name" --label "tuti.restore-test=$test_id" --network none \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=32m -e NODE_OPTIONS=--max-old-space-size=256 \
    -v "$scratch:/evidence:ro" -v "$project_dir/scripts/ops/core-backup-excluded-data-tables.txt:/sandbox-policy/excluded.txt:ro" \
    -v "$project_dir/scripts/compare-core-restore.ts:/app/scripts/compare-core-restore.ts:ro" \
    -v "$project_dir/src/server/legal/coreRestoreComparison.ts:/app/src/server/legal/coreRestoreComparison.ts:ro" \
    --entrypoint node tuti:ops --import tsx scripts/compare-core-restore.ts; then exit 1; fi
  printf '{"stage":"core-database-round-trip","status":"completed","elapsedSeconds":%s,"archiveBytes":%s,"artifactPolicy":"remove-during-sandbox-cleanup"}\n' "$(( $(date +%s) - core_started_at ))" "$core_archive_bytes"
  restore_db=core_restore_test
fi
stage="isolated-database-observations"
if ! timeout 30 docker exec -i "$pg_name" psql --host /var/run/postgresql --port 5432 --no-psqlrc -U postgres -d "$restore_db" -At -v ON_ERROR_STOP=1 \
  < scripts/ops/isolated-restore-observations.sql > "$scratch/references.json" 2> "$scratch/query.log"; then exit 1; fi
stage="isolated-objects-and-content"
if ! limits 384m --rm --name "$node_name" --label "tuti.restore-test=$test_id" --network "container:$garage_name" \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=32m -e NODE_OPTIONS=--max-old-space-size=256 -e TUTI_ISOLATED_RESTORE=true -e TUTI_CORE_RESTORE_TEST="$core_test" \
  -v "$backup_dir:/backup:ro" -v "$scratch:/evidence:ro" \
  -v "$project_dir/scripts/verify-isolated-production-restore.ts:/app/scripts/verify-isolated-production-restore.ts:ro" \
  -v "$project_dir/src/server/legal/isolatedRestoreVerification.ts:/app/src/server/legal/isolatedRestoreVerification.ts:ro" \
  --entrypoint node tuti:ops --import tsx scripts/verify-isolated-production-restore.ts; then exit 1; fi
