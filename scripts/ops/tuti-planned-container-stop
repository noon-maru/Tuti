#!/bin/sh
# Only planned, maintenance-locked stops use DSM's own container stop API.
# Never disable notifications or rewrite Container Manager's private config files.
set -eu
case "$#:$*" in
  1:--check) mode=check; container="" ;;
  1:tuti-prod | 1:tuti-ops-maintenance | 1:tuti-ops-recovery | 1:tuti-ops-retention)
    mode=stop; container="$1" ;;
  *) echo "지원 대상: --check 또는 운영 앱·상시 작업 컨테이너 이름" >&2; exit 1 ;;
esac
if [ "$(id -u)" != 0 ]; then echo "NAS 관리자 권한이 필요합니다." >&2; exit 1; fi
api=/usr/syno/bin/synowebapi
definition=/var/packages/ContainerManager/target/webapi/SYNO.Docker.lib
if [ ! -x "$api" ] || ! jq -e '
  .["SYNO.Docker.Container"] |
  .minVersion <= 1 and .maxVersion >= 1 and any(.methods["1"][]; has("stop"))
' "$definition" >/dev/null 2>&1; then
  echo "DSM 정상 중지 API를 확인하지 못했습니다. Docker 중지로 우회하지 않습니다." >&2; exit 1
fi
if [ "$mode" = check ]; then
  # Read-only round trip also checks CLI permissions and response format before installation.
  if ! response="$(timeout 45 "$api" --exec api=SYNO.Docker.Container method=get version=1 name=tuti-prod 2>/dev/null)" ||
     ! printf '%s' "$response" | jq -e '.success == true' >/dev/null 2>&1; then
    echo "DSM 조회 API 응답을 검증하지 못했습니다. 설치·중지를 진행하지 않습니다." >&2; exit 1
  fi
  unset response
  echo '{"plannedStopApiAvailable":true,"notificationsChanged":false,"containersStopped":false}'
  exit 0
fi
project_dir=/var/services/homes/Tutiadmin/source/Tuti
project_dir="$(CDPATH= cd -- "$project_dir" && pwd -P)"
# Require the caller's maintenance FD and an exclusive lock before any stop request.
if [ "$(readlink "/proc/$$/fd/9" 2>/dev/null || true)" != "$project_dir/.ops-state/maintenance.lock" ] ||
   ! /usr/bin/flock --exclusive --nonblock 9; then
  echo "유지보수 배타 잠금 없이 컨테이너를 중지할 수 없습니다." >&2; exit 1
fi
state_format='{{.Id}}|{{.State.Running}}|{{.State.ExitCode}}|{{.State.OOMKilled}}|{{.State.FinishedAt}}|{{.State.StartedAt}}'
before="$(timeout 10 docker inspect --format "$state_format" "$container")"
IFS='|' read -r original_id running initial_exit initial_oom finished_before started_before <<EOF
$before
EOF
if ! printf '%s' "$original_id" | LC_ALL=C grep -Eq '^[0-9a-f]{64}$' || [ -z "$started_before" ]; then
  echo "중지 전 컨테이너 식별 상태를 확인하지 못했습니다." >&2; exit 1
fi
case "$running" in false) exit 0 ;; true) ;; *) exit 1 ;; esac
# CLI output can contain package diagnostics. Never print it or credentials.
request_ok=false
response_ok=false
json_valid=false
provider_error=unknown
post_stop_1301=false
if response="$(timeout 45 "$api" --exec api=SYNO.Docker.Container method=stop version=1 "name=$container" 2>/dev/null)"; then
  request_ok=true
  if printf '%s' "$response" | jq -e -s 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1; then
    json_valid=true
    if printf '%s' "$response" | jq -e '.success == true' >/dev/null 2>&1; then response_ok=true; fi
    provider_error="$(printf '%s' "$response" | jq -r '.error | if type == "object" then .code | if type == "number" then tostring else "unknown" end else "unknown" end')"
    if [ "$provider_error" = 1301 ] && printf '%s' "$response" | jq -e '.success == false' >/dev/null 2>&1; then
      post_stop_1301=true
    fi
  fi
fi
unset response
# 응답이 깨지거나 CLI가 실패해도 실제 중지 여부는 별도로 관측한다.
# 불명확한 응답은 실패로 남긴다. 관측된 1301만 아래의 동일 컨테이너 상태 검증 대상으로 허용한다.
if [ "$response_ok" != true ] && [ "$post_stop_1301" != true ]; then
  observed_state="$(docker inspect --format '{{.State.Running}}|{{.State.ExitCode}}|{{.State.OOMKilled}}' "$container" 2>/dev/null || true)"
  case "$observed_state" in
    false\|*) observation=stopped ;;
    true\|*) observation=running ;;
    *) observation=unknown ;;
  esac
  printf 'DSM 계획 중지 검증 실패: request_ok=%s response_ok=false json_valid=%s provider_error=%s observed=%s. 백업·배포를 중단하고 호출자 복구로 넘깁니다.\n' "$request_ok" "$json_valid" "$provider_error" "$observation" >&2
  exit 1
fi
attempt=0
while [ "$attempt" -lt 15 ]; do
  if ! after="$(timeout 10 docker inspect --format "$state_format" "$container" 2>/dev/null)"; then
    echo "중지 후 원래 컨테이너를 조회하지 못했습니다. 정상 중지로 처리하지 않습니다." >&2; exit 1
  fi
  IFS='|' read -r current_id current_running exit_code oom finished_after started_after <<EOF
$after
EOF
  if [ "$current_id" != "$original_id" ] || [ "$started_after" != "$started_before" ]; then
    echo "중지 도중 컨테이너가 교체·재시작됐습니다. 정상 중지로 처리하지 않습니다." >&2; exit 1
  fi
  case "$current_running|$exit_code|$oom" in
    'false|0|false' | 'false|143|false')
      case "$finished_after" in '' | 0001-*) echo "컨테이너 종료 시각을 확인하지 못했습니다." >&2; exit 1 ;; esac
      if ! printf '%s' "$finished_after" | LC_ALL=C grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$'; then
        echo "컨테이너 종료 시각 형식을 확인하지 못했습니다." >&2; exit 1
      fi
      if [ "$finished_after" = "$finished_before" ]; then
        echo "중지 요청 이후의 실제 종료를 확인하지 못했습니다." >&2; exit 1
      fi
      if [ "$post_stop_1301" = true ]; then
        echo "DSM 응답 1301: 원래 ID·시작 시각 유지, 새 종료 시각·정상 종료·OOM 없음으로 중지 확인."
      fi
      printf '계획된 컨테이너 중지 확인: %s\n' "$container"; exit 0 ;;
    true\|*) sleep 1 ;;
    *) echo "중지 후 비정상 종료·OOM 여부를 점검해야 합니다." >&2; exit 1 ;;
  esac
  attempt=$((attempt + 1))
done
echo "DSM 요청 후 컨테이너 중지를 확인하지 못했습니다." >&2
exit 1
