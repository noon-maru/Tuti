#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
report_root="$project_dir/.ops-state/journal-publication-audit"
timestamp="$(date '+%Y%m%d-%H%M%S%z')"
report_dir="$report_root/$timestamp"
operator_id="${SUDO_USER:-Tutiadmin}"
operator_group="$(id -gn "$operator_id")"

umask 077
install -d -o "$operator_id" -g "$operator_group" -m 0700 \
  "$report_root" "$report_dir"
cd "$project_dir"

run_audit() {
  environment="$1"
  output="$report_dir/$environment.json"

  if [ "$environment" = development ]; then
    echo "개발 DB 기록 공개 운영상태 점검"
    docker compose -f docker-compose.dev.yml exec -T \
      -e TUTI_INSPECTION_ENV=development \
      app node_modules/.bin/tsx scripts/inspect-journal-publications.ts \
      >"$output"
  else
    echo "운영 DB 기록 공개 운영상태 점검"
    docker compose --env-file .env.production -f docker-compose.prod.yml \
      run --rm --no-deps -T \
      -e TUTI_INSPECTION_ENV=production \
      ops node_modules/.bin/tsx scripts/inspect-journal-publications.ts \
      >"$output"
  fi

  chmod 0600 "$output"
  chown "$operator_id:$operator_group" "$output"
}

run_audit development
run_audit production

(
  cd "$report_dir"
  sha256sum development.json production.json >SHA256SUMS
)
chmod 0600 "$report_dir/SHA256SUMS"
chown "$operator_id:$operator_group" "$report_dir/SHA256SUMS"

echo "개발·운영 기록 공개 운영상태 점검을 완료했습니다."
echo "$report_dir"
