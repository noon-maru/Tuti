#!/bin/sh
set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
tools="tuti-prod-backup tuti-prod-restore tuti-prod-deploy tuti-prod-rollback tuti-prod-health tuti-auth-retention-purge tuti-location-compliance-purge tuti-journal-moderation-purge tuti-journal-rights-maintain tuti-prod-backup-prune tuti-legal-operations-inspect"
case "$#:$*" in 0:) apply=false ;; 1:--apply) apply=true ;; *) echo "사용법: install-legal-compliance-tools [--apply]" >&2; exit 1 ;; esac
cd "$project_dir"
for name in $tools; do
  source="scripts/ops/$name"
  if ! git -c safe.directory="$project_dir" ls-files --error-unmatch "$source" >/dev/null 2>&1 || \
     ! git -c safe.directory="$project_dir" diff --quiet HEAD -- "$source"; then
    echo "검토·커밋이 필요한 설치 원본: $source" >&2
    if [ "$apply" = true ]; then exit 1; fi
  fi
  sh -n "$source"
  if [ -L "/usr/local/sbin/$name" ]; then echo "심볼릭 링크인 설치 대상은 교체하지 않습니다: $name" >&2; exit 1; fi
  printf '%s -> /usr/local/sbin/%s\n' "$source" "$name"
done
if [ "$apply" != true ]; then echo "조회 전용입니다. 검토·커밋 후 root로 --apply를 실행해주세요."; exit 0; fi
if [ "$(id -u)" != 0 ]; then echo "root 권한이 필요합니다." >&2; exit 1; fi

install -d -o root -g root -m 0700 "$project_dir/.ops-state/legal-tools"
exec 9>"$project_dir/.ops-state/maintenance.lock"
/usr/bin/flock --exclusive 9
snapshot="$project_dir/.ops-state/legal-tools/$(date +%Y%m%d-%H%M%S)-$$"
install -d -o root -g root -m 0700 "$snapshot"
for name in $tools; do
  if [ -f "/usr/local/sbin/$name" ]; then cp -p "/usr/local/sbin/$name" "$snapshot/$name"; fi
done
for name in $tools; do install -o root -g root -m 0750 "scripts/ops/$name" "/usr/local/sbin/$name"; done
echo "운영 도구 설치 완료. 이전 설치본 보관: $snapshot"
echo "환경변수·원장 초기화·DB 마이그레이션·예약 작업·서비스 재시작은 실행하지 않았습니다."
