#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
state_dir="$project_dir/.ops-state"
marker_file="$state_dir/place-candidate-editorial-synced-at"
lock_dir="/tmp/tuti-place-candidate-refresh.lock"
editorial_dump=""
place_dump=""
limit="${TUTI_PLACE_CANDIDATE_LIMIT:-950}"
concurrency="${TUTI_PLACE_CANDIDATE_CONCURRENCY:-2}"

skip_enrichment=false
until_quota=false

if [ "$#" -gt 0 ]; then
  if [ "$#" -eq 1 ] && [ "$1" = "--skip-enrichment" ]; then
    skip_enrichment=true
  elif [ "$#" -eq 1 ] && [ "$1" = "--until-quota" ]; then
    until_quota=true
  else
    echo "사용법: tuti-place-candidate-refresh [--skip-enrichment|--until-quota]" >&2
    exit 1
  fi
fi

case "$limit" in
  '' | *[!0-9]*) echo "TUTI_PLACE_CANDIDATE_LIMIT는 양의 정수여야 합니다." >&2; exit 1 ;;
esac
case "$concurrency" in
  1 | 2 | 3 | 4) ;;
  *) echo "TUTI_PLACE_CANDIDATE_CONCURRENCY는 1~4여야 합니다." >&2; exit 1 ;;
esac

if ! mkdir "$lock_dir" 2>/dev/null; then
  echo "장소 후보 갱신 작업이 이미 실행 중입니다." >&2
  exit 1
fi

cleanup() {
  if [ -n "$editorial_dump" ]; then
    rm -f "$editorial_dump"
  fi
  if [ -n "$place_dump" ]; then
    rm -f "$place_dump"
  fi
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

install -d -o root -g root -m 0755 "$state_dir"
editorial_dump="$(mktemp /tmp/tuti-place-editorials.XXXXXX.copy)"
place_dump="$(mktemp /tmp/tuti-candidate-places.XXXXXX.copy)"
last_marker="1970-01-01T00:00:00Z"
if [ -s "$marker_file" ]; then
  last_marker="$(sed -n '1p' "$marker_file")"
fi
case "$last_marker" in
  ????-??-??T??:??:??Z) ;;
  *) echo "증분 동기화 기준 시각이 올바르지 않습니다: $last_marker" >&2; exit 1 ;;
esac
job_started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

cd "$project_dir"

echo "개발·운영 실행 환경 확인"
if ! docker compose -f docker-compose.dev.yml exec -T app \
  sh -lc 'test -x node_modules/.bin/tsx && test -f scripts/refresh-place-candidates.ts'; then
  echo "개발 컨테이너 준비가 필요합니다: sudo -n /usr/local/sbin/tuti-dev-refresh" >&2
  exit 1
fi

if ! docker compose \
  --env-file .env.production \
  -f docker-compose.prod.yml \
  run --rm --no-deps -T ops \
  sh -lc 'test -x node_modules/.bin/tsx && test -f scripts/refresh-place-candidates.ts'; then
  echo "최신 운영 ops 이미지가 필요합니다: sudo -n /usr/local/sbin/tuti-prod-deploy" >&2
  exit 1
fi

for target in development production; do
  if [ "$target" = development ]; then
    schema_ready="$(
      docker compose -f docker-compose.dev.yml exec -T db sh -lc \
        'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --tuples-only --no-align --command "SELECT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = '\''public'\'' AND table_name = '\''places'\'' AND column_name = '\''candidate_status'\'')"'
    )"
  else
    schema_ready="$(
      docker compose --env-file .env.production -f docker-compose.prod.yml \
        exec -T db sh -lc \
        'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --tuples-only --no-align --command "SELECT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = '\''public'\'' AND table_name = '\''places'\'' AND column_name = '\''candidate_status'\'')"'
    )"
  fi

  if [ "$schema_ready" != "t" ]; then
    echo "$target DB에 후보 판정 마이그레이션이 필요합니다. 개발·운영 배포 명령을 먼저 실행해주세요." >&2
    exit 1
  fi
done

echo "개발 DB 장소 소개정보 보강 및 후보 재판정"
refresh_arguments="--limit '$limit' --concurrency '$concurrency'"
if [ "$skip_enrichment" = true ]; then
  refresh_arguments="--skip-enrichment"
  echo "소개정보 추가 호출을 건너뛰고 중단된 증분 반영부터 재개합니다."
elif [ "$until_quota" = true ]; then
  refresh_arguments="--limit '20000' --concurrency '$concurrency'"
  echo "남은 장소를 API 호출 한도에 도달할 때까지 보강합니다."
fi
docker compose \
  -f docker-compose.dev.yml \
  exec -T app \
  su node -c \
  "node_modules/.bin/tsx scripts/refresh-place-candidates.ts $refresh_arguments"

echo "개발 DB 관광지 장소 스냅샷 생성"
printf '%s\n' \
  "COPY (SELECT id, name, phrase, note, image, travel_time, crowd, today, fatigue, movement_level::text, mood_tags, latitude, longitude, source, source_id, source_content_type, source_address, source_area_code, source_sido_name, source_sigungu_code, source_sigungu_name, source_copyright, source_modified_at, source_synced_at, review_status::text, is_active, candidate_override::text, created_at, updated_at FROM public.places WHERE source = 'tourapi' ORDER BY id) TO STDOUT;" \
  | docker compose \
    -f docker-compose.dev.yml \
    exec -T db \
    sh -lc 'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --quiet --set ON_ERROR_STOP=1' \
  > "$place_dump"

echo "운영 DB에 누락된 관광지 장소 증분 생성"
{
  cat <<'SQL'
BEGIN;
CREATE TEMP TABLE candidate_place_stage (
  id text,
  name text,
  phrase text,
  note text,
  image text,
  travel_time text,
  crowd text,
  today text,
  fatigue integer,
  movement_level text,
  mood_tags text[],
  latitude numeric(9, 6),
  longitude numeric(9, 6),
  source text,
  source_id text,
  source_content_type text,
  source_address text,
  source_area_code text,
  source_sido_name text,
  source_sigungu_code text,
  source_sigungu_name text,
  source_copyright text,
  source_modified_at timestamp(3),
  source_synced_at timestamp(3),
  review_status text,
  is_active boolean,
  candidate_override text,
  created_at timestamp(3),
  updated_at timestamp(3)
) ON COMMIT DROP;
COPY candidate_place_stage FROM STDIN;
SQL
  cat "$place_dump"
  cat <<'SQL'
\.
INSERT INTO public.places (
  id, name, phrase, note, image, travel_time, crowd, today, fatigue,
  movement_level, mood_tags, latitude, longitude, source, source_id,
  source_content_type, source_address, source_area_code, source_sido_name,
  source_sigungu_code, source_sigungu_name, source_copyright,
  source_modified_at, source_synced_at, review_status, is_active,
  candidate_override, created_at, updated_at
)
SELECT
  id, name, phrase, note, image, travel_time, crowd, today, fatigue,
  movement_level::"MovementLevel", mood_tags, latitude, longitude, source,
  source_id, source_content_type, source_address, source_area_code,
  source_sido_name, source_sigungu_code, source_sigungu_name,
  source_copyright, source_modified_at, source_synced_at,
  review_status::"PlaceReviewStatus", is_active,
  candidate_override::"PlaceCandidateOverride", created_at, updated_at
FROM candidate_place_stage
ON CONFLICT DO NOTHING;

UPDATE public.places AS place
SET location = ST_SetSRID(
  ST_MakePoint(place.longitude::double precision, place.latitude::double precision),
  4326
)
FROM candidate_place_stage AS stage
WHERE place.source = stage.source
  AND place.source_id = stage.source_id
  AND place.location IS NULL;

UPDATE public.tourism_place_source_records AS source
SET linked_place_id = place.id
FROM public.places AS place
WHERE source.linked_place_id IS NULL
  AND place.source = 'tourapi'
  AND place.source_id = source.content_id;
COMMIT;
SQL
} | docker compose \
  --env-file .env.production \
  -f docker-compose.prod.yml \
  exec -T db \
  sh -lc 'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --set ON_ERROR_STOP=1'

echo "개발 DB 소개정보 증분 스냅샷 생성: $last_marker 이후"
printf '%s\n' \
  "COPY (SELECT content_id, content_type_id, overview, homepage, phone, opening_hours, rest_date, admission_fee, parking, reservation, usage_duration, experience_guide, common_payload, intro_payload, source_modified_at, editorial_synced_at, editorial_attempt_at, editorial_retry_after, editorial_last_error, created_at, updated_at FROM public.tourism_place_detail_records WHERE editorial_synced_at >= TIMESTAMPTZ '$last_marker' ORDER BY content_id) TO STDOUT;" \
  | docker compose \
    -f docker-compose.dev.yml \
    exec -T db \
    sh -lc 'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --quiet --set ON_ERROR_STOP=1' \
  > "$editorial_dump"

echo "운영 DB에 소개정보 증분 반영"
{
  cat <<'SQL'
BEGIN;
CREATE TEMP TABLE candidate_editorial_stage (
  content_id text,
  content_type_id text,
  overview text,
  homepage text,
  phone text,
  opening_hours text,
  rest_date text,
  admission_fee text,
  parking text,
  reservation text,
  usage_duration text,
  experience_guide text,
  common_payload jsonb,
  intro_payload jsonb,
  source_modified_at timestamp(3),
  editorial_synced_at timestamp(3),
  editorial_attempt_at timestamp(3),
  editorial_retry_after timestamp(3),
  editorial_last_error text,
  created_at timestamp(3),
  updated_at timestamp(3)
) ON COMMIT DROP;
COPY candidate_editorial_stage FROM STDIN;
SQL
  cat "$editorial_dump"
  cat <<'SQL'
\.
INSERT INTO public.tourism_place_detail_records (
  content_id, content_type_id, overview, homepage, phone, opening_hours,
  rest_date, admission_fee, parking, reservation, usage_duration,
  experience_guide, common_payload, intro_payload, source_modified_at,
  editorial_synced_at, editorial_attempt_at, editorial_retry_after,
  editorial_last_error, created_at, updated_at
)
SELECT
  stage.content_id, stage.content_type_id, stage.overview, stage.homepage,
  stage.phone, stage.opening_hours, stage.rest_date, stage.admission_fee,
  stage.parking, stage.reservation, stage.usage_duration,
  stage.experience_guide, stage.common_payload, stage.intro_payload,
  stage.source_modified_at, stage.editorial_synced_at,
  stage.editorial_attempt_at, stage.editorial_retry_after,
  stage.editorial_last_error, stage.created_at, stage.updated_at
FROM candidate_editorial_stage AS stage
JOIN public.tourism_place_source_records AS source
  ON source.content_id = stage.content_id
ON CONFLICT (content_id) DO UPDATE SET
  content_type_id = EXCLUDED.content_type_id,
  overview = EXCLUDED.overview,
  homepage = EXCLUDED.homepage,
  phone = EXCLUDED.phone,
  opening_hours = EXCLUDED.opening_hours,
  rest_date = EXCLUDED.rest_date,
  admission_fee = COALESCE(EXCLUDED.admission_fee, public.tourism_place_detail_records.admission_fee),
  parking = EXCLUDED.parking,
  reservation = EXCLUDED.reservation,
  usage_duration = EXCLUDED.usage_duration,
  experience_guide = EXCLUDED.experience_guide,
  common_payload = EXCLUDED.common_payload,
  intro_payload = EXCLUDED.intro_payload,
  source_modified_at = EXCLUDED.source_modified_at,
  editorial_synced_at = EXCLUDED.editorial_synced_at,
  editorial_attempt_at = EXCLUDED.editorial_attempt_at,
  editorial_retry_after = EXCLUDED.editorial_retry_after,
  editorial_last_error = EXCLUDED.editorial_last_error,
  updated_at = GREATEST(
    public.tourism_place_detail_records.updated_at,
    EXCLUDED.updated_at
  )
WHERE
  public.tourism_place_detail_records.editorial_synced_at IS NULL
  OR EXCLUDED.editorial_synced_at >= public.tourism_place_detail_records.editorial_synced_at;
COMMIT;
SQL
} | docker compose \
  --env-file .env.production \
  -f docker-compose.prod.yml \
  exec -T db \
  sh -lc 'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --set ON_ERROR_STOP=1'

echo "운영 DB 장소 후보 재판정"
docker compose \
  --env-file .env.production \
  -f docker-compose.prod.yml \
  run --rm --no-deps -T ops \
  node_modules/.bin/tsx scripts/refresh-place-candidates.ts --skip-enrichment

printf '%s\n' "$job_started" > "$marker_file"
chmod 0644 "$marker_file"

echo "개발·운영 후보 상태 비교"
for target in development production; do
  if [ "$target" = development ]; then
    compose_command="docker compose -f docker-compose.dev.yml"
  else
    compose_command="docker compose --env-file .env.production -f docker-compose.prod.yml"
  fi
  # 명령은 고정 문자열로만 구성되며 사용자 입력을 포함하지 않습니다.
  # shellcheck disable=SC2086
  $compose_command exec -T db sh -lc \
    'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --tuples-only --no-align --field-separator="," --command "SELECT COALESCE(candidate_status::text, '\''unassessed'\''), count(*) FROM public.places WHERE source = '\''tourapi'\'' GROUP BY candidate_status ORDER BY 1"' \
    | sed "s/^/$target, /"
done

echo "장소 후보 일일 갱신을 완료했습니다. 다음 증분 기준: $job_started"
