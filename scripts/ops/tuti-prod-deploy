#!/bin/sh

set -eu

PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
export PATH

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
state_dir="$project_dir/.ops-state/deploy"
state_file="$state_dir/releases.env"
lock_dir="$state_dir/deploy.lock"
maintenance_dir="$project_dir/.ops-state/maintenance"
maintenance_marker="$maintenance_dir/$$"
maintenance_lock_file="$project_dir/.ops-state/maintenance.lock"
revision="$(git -C "$project_dir" rev-parse --short=12 HEAD)"
app_image="tuti:prod-$revision"
ops_image="tuti:ops-$revision"
remote_app_image="${TUTI_REMOTE_APP_IMAGE:-}"
remote_ops_image="${TUTI_REMOTE_OPS_IMAGE:-}"
previous_image="$(docker inspect tuti-prod --format '{{.Config.Image}}' 2>/dev/null || true)"
previous_release="$(docker inspect tuti-prod --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^TUTI_RELEASE=//p' | head -n 1)"

case "$revision" in
  *[!0-9a-f]* | "")
    echo "배포 Git 리비전을 확인하지 못했습니다." >&2
    exit 1
    ;;
esac

if { [ -n "$remote_app_image" ] && [ -z "$remote_ops_image" ]; } \
  || { [ -z "$remote_app_image" ] && [ -n "$remote_ops_image" ]; }; then
  echo "원격 배포에는 앱 이미지와 운영 이미지가 모두 필요합니다." >&2
  exit 1
fi

if [ -n "$(git -C "$project_dir" status --porcelain)" ]; then
  echo "커밋되지 않은 변경사항이 있어 운영 이미지의 출처를 확정할 수 없습니다." >&2
  echo "변경사항을 커밋한 뒤 다시 배포하세요." >&2
  exit 1
fi

install -d -o root -g root -m 0700 "$state_dir"
install -d -o root -g root -m 0700 "$maintenance_dir"
if ! mkdir "$lock_dir" 2>/dev/null; then
  echo "다른 운영 배포가 진행 중입니다." >&2
  exit 1
fi
exec 9>"$maintenance_lock_file"
/usr/bin/flock --exclusive 9
printf 'deploy\n' > "$maintenance_marker"
chmod 0600 "$maintenance_marker"
trap 'rm -f "$maintenance_marker"; rmdir "$lock_dir" 2>/dev/null || true' EXIT INT TERM

case "$previous_image" in
  "") ;;
  tuti:prod-*) ;;
  *)
    preserved_image="tuti:prod-before-$revision"
    docker tag "$previous_image" "$preserved_image"
    previous_image="$preserved_image"
    ;;
esac

cd "$project_dir"

export TUTI_APP_IMAGE="$app_image"
export TUTI_OPS_IMAGE="$ops_image"
export TUTI_RELEASE="$revision"

if [ -n "$remote_app_image" ]; then
  echo "GitHub Container Registry 운영 이미지 확인: $revision"
  docker pull "$remote_app_image"
  docker pull "$remote_ops_image"
  docker tag "$remote_app_image" "$app_image"
  docker tag "$remote_ops_image" "$ops_image"
else
  echo "커밋별 운영 이미지 빌드: $revision"
  docker compose --env-file .env.production -f docker-compose.prod.yml build --pull ops app
fi

echo "운영 앱·작업 이미지 Node.js 26 런타임 검사"
docker run --rm --network none --read-only --entrypoint node "$app_image" /app/scripts/check-node-runtime.mjs
docker run --rm --network none --read-only --entrypoint node "$ops_image" /app/scripts/check-node-runtime.mjs

echo "배포 이미지 테스트"
docker compose --env-file .env.production -f docker-compose.prod.yml \
  run --rm --no-deps ops pnpm test

echo "추천 파생 데이터 읽기 전용 사전 검사"
if [ -f "$project_dir/.ops-state/restore-privacy/pending.env" ] || [ -f "$project_dir/.ops-state/privacy-activation/pending" ]; then
  docker compose --env-file .env.production -f docker-compose.prod.yml up --no-start --no-deps --no-build --pull never app
  docker update --restart=no tuti-prod
  echo "새 앱 이미지 준비 완료. DB 복원 후 확인 대기 중이므로 마이그레이션·서비스 시작은 보류합니다."
  exit 0
fi
docker compose --env-file .env.production -f docker-compose.prod.yml \
  run --rm --no-deps ops pnpm db:derived:check

echo "배포 직전 전체 백업"
sh scripts/ops/tuti-prod-backup

# 컬럼 삭제 뒤에는 예전 Prisma 클라이언트가 읽기에도 실패한다.
# 현재 앱을 먼저 멈추고 새 앱과 스키마를 함께 전환한다.
harumadi_column_present() {
  docker compose --env-file .env.production -f docker-compose.prod.yml exec -T db \
    sh -c 'exec psql -X -A -t -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'
SELECT count(1) FROM information_schema.columns WHERE table_schema='public' AND table_name='harumadis' AND column_name='inner_style';
SQL
}
image_matches_schema() {
  [ -n "$1" ] || return 1
  column="$(harumadi_column_present)" || return 1
  case "$column" in
    1) return 0 ;;
    0) [ "$(docker image inspect "$1" --format '{{index .Config.Labels "com.tuti.harumadi-layout"}}' 2>/dev/null)" = "automatic" ] ;;
    *) return 1 ;;
  esac
}
if [ -f prisma/migrations/20261028120000_remove_harumadi_inner_style/migration.sql ]; then
  if [ "$(docker image inspect "$app_image" --format '{{index .Config.Labels "com.tuti.harumadi-layout"}}')" != "automatic" ]; then
    echo "자동 지면 스키마와 새 앱 이미지가 일치하지 않아 전환하지 않습니다." >&2
    exit 1
  fi
  column="$(harumadi_column_present)"
  case "$column" in
    1)
      echo "속지 설정 열 삭제 전 운영 앱을 중지합니다. 마이그레이션 후 새 앱으로 재개합니다."
      docker compose --env-file .env.production -f docker-compose.prod.yml stop app
      ;;
    0) ;;
    *) echo "운영 DB 스키마를 확인하지 못해 전환하지 않습니다." >&2; exit 1 ;;
  esac
fi

echo "운영 DB 마이그레이션"
if ! { docker compose --env-file .env.production -f docker-compose.prod.yml \
  run --rm ops pnpm db:deploy \
  && docker compose --env-file .env.production -f docker-compose.prod.yml \
  run --rm ops pnpm transport:hubs:sync; }; then
  if image_matches_schema "$previous_image"; then
    TUTI_APP_IMAGE="$previous_image" TUTI_RELEASE="${previous_release:-rollback}" \
      docker compose --env-file .env.production -f docker-compose.prod.yml up -d --no-deps app
  else
    echo "마이그레이션 실패: 스키마와 맞지 않는 이전 앱은 재시작하지 않습니다. DB는 자동 복원하지 않았습니다." >&2
  fi
  exit 1
fi
echo "새 운영 앱 교체"
docker compose --env-file .env.production -f docker-compose.prod.yml \
  up -d --no-deps app

healthy=false
attempt=1
while [ "$attempt" -le 12 ]; do
  if docker compose --env-file .env.production -f docker-compose.prod.yml \
    exec -T app node -e \
    'Promise.all([fetch("http://127.0.0.1:3000/api/health"), fetch("http://127.0.0.1:3000/")]).then(responses=>{if(responses.some(response=>!response.ok))process.exit(1)}).catch(()=>process.exit(1))' \
    >/dev/null 2>&1; then
    healthy=true
    break
  fi
  sleep 5
  attempt=$((attempt + 1))
done

if [ "$healthy" != true ]; then
  echo "새 버전 readiness 확인에 실패했습니다." >&2
  if image_matches_schema "$previous_image"; then
    echo "이전 앱 이미지로 복귀합니다: $previous_image" >&2
    TUTI_APP_IMAGE="$previous_image" TUTI_RELEASE="${previous_release:-rollback}" \
      docker compose --env-file .env.production -f docker-compose.prod.yml \
      up -d --no-deps app
  else
    echo "이전 앱은 현재 스키마와 호환되지 않아 자동 롤백하지 않습니다." >&2
  fi
  echo "DB 마이그레이션은 자동으로 되돌리지 않았습니다. expand-contract 원칙에 따라 확인하세요." >&2
  exit 1
fi

cat > "$state_file" <<EOF
current_image=$app_image
current_ops_image=$ops_image
current_release=$revision
previous_image=${previous_image:-}
previous_release=${previous_release:-}
deployed_at=$(date -Iseconds)
EOF
chmod 0600 "$state_file"

docker tag "$app_image" tuti:prod
docker tag "$ops_image" tuti:ops

# Refresh opt-in persistent workers under the deployment maintenance lock.
if [ -f "$project_dir/.ops-state/ops-workers/enabled" ]; then
  /usr/local/sbin/tuti-ops-workers --refresh-locked
fi

prune_release_tags() {
  prefix="$1"
  docker image ls tuti --format '{{.Repository}}:{{.Tag}}' \
    | grep "^tuti:${prefix}-" \
    | awk 'NR > 5' \
    | while IFS= read -r stale_image; do
        [ -n "$stale_image" ] || continue
        docker image rm "$stale_image" >/dev/null 2>&1 || true
      done
}

prune_release_tags prod
prune_release_tags ops

docker compose --env-file .env.production -f docker-compose.prod.yml ps
echo "운영 배포 완료: $revision"
echo "문제가 있으면 sudo -n /usr/local/sbin/tuti-prod-rollback 을 실행하세요."
