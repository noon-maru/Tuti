#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
state_file="$project_dir/.ops-state/deploy/releases.env"
maintenance_dir="$project_dir/.ops-state/maintenance"
maintenance_marker="$maintenance_dir/$$"
maintenance_lock_file="$project_dir/.ops-state/maintenance.lock"

if [ ! -f "$state_file" ]; then
  echo "이전 배포 상태가 없습니다. 커밋별 배포를 한 번 이상 완료해야 합니다." >&2
  exit 1
fi

read_value() {
  sed -n "s/^${1}=//p" "$state_file" | head -n 1
}

current_image="$(read_value current_image)"
current_release="$(read_value current_release)"
previous_image="$(read_value previous_image)"
previous_release="$(read_value previous_release)"

case "$previous_image" in
  tuti:prod-*) ;;
  *)
    echo "롤백 가능한 이전 앱 이미지가 없습니다: $previous_image" >&2
    exit 1
    ;;
esac

if ! docker image inspect "$previous_image" >/dev/null 2>&1; then
  echo "이전 앱 이미지가 Docker에 남아 있지 않습니다: $previous_image" >&2
  exit 1
fi

install -d -o root -g root -m 0700 "$maintenance_dir"
exec 9>"$maintenance_lock_file"
/usr/bin/flock --exclusive 9
printf 'rollback\n' > "$maintenance_marker"
chmod 0600 "$maintenance_marker"
trap 'rm -f "$maintenance_marker"' EXIT INT TERM

cd "$project_dir"
if [ -f "$project_dir/.ops-state/restore-privacy/pending.env" ] || [ -f "$project_dir/.ops-state/privacy-activation/pending" ]; then
  # 코드 롤백은 준비하되 확인 대기 중인 복원 데이터를 공개하지 않는다.
  TUTI_APP_IMAGE="$previous_image" TUTI_RELEASE="${previous_release:-rollback}" \
    docker compose --env-file .env.production -f docker-compose.prod.yml up --no-start --no-deps --no-build --pull never app
  docker update --restart=no tuti-prod
  echo "이전 앱 이미지로 교체 준비 완료. DB 복원 후 확인 대기 상태여서 서비스 시작만 보류합니다."
  exit 0
fi
column="$(docker compose --env-file .env.production -f docker-compose.prod.yml exec -T db \
  sh -c 'exec psql -X -A -t -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'
SELECT count(1) FROM information_schema.columns WHERE table_schema='public' AND table_name='harumadis' AND column_name='inner_style';
SQL
)"
case "$column" in
  1) ;;
  0)
    if [ "$(docker image inspect "$previous_image" --format '{{index .Config.Labels "com.tuti.harumadi-layout"}}')" != "automatic" ]; then
      echo "이전 앱은 삭제된 속지 설정 열을 요구합니다. 현재 DB와 호환되지 않아 롤백하지 않습니다." >&2
      exit 1
    fi
    ;;
  *) echo "DB 스키마를 확인하지 못해 롤백하지 않습니다." >&2; exit 1 ;;
esac
echo "앱 이미지를 이전 버전으로 되돌립니다: $previous_image"
TUTI_APP_IMAGE="$previous_image" TUTI_RELEASE="${previous_release:-rollback}" \
  docker compose --env-file .env.production -f docker-compose.prod.yml \
  up -d --no-deps app

attempt=1
while [ "$attempt" -le 12 ]; do
  if docker compose --env-file .env.production -f docker-compose.prod.yml \
    exec -T app node -e \
    'Promise.all([fetch("http://127.0.0.1:3000/api/health"), fetch("http://127.0.0.1:3000/")]).then(responses=>{if(responses.some(response=>!response.ok))process.exit(1)}).catch(()=>process.exit(1))' \
    >/dev/null 2>&1; then
    cat > "$state_file" <<EOF
current_image=$previous_image
current_ops_image=
current_release=${previous_release:-rollback}
previous_image=$current_image
previous_release=$current_release
deployed_at=$(date -Iseconds)
EOF
    chmod 0600 "$state_file"
    echo "운영 앱 롤백 완료: ${previous_release:-$previous_image}"
    echo "DB 스키마는 되돌리지 않았습니다. 데이터 호환성을 확인하세요."
    exit 0
  fi
  sleep 5
  attempt=$((attempt + 1))
done

echo "이전 앱 이미지도 readiness 확인에 실패했습니다." >&2
exit 1
