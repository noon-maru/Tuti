[Unit]
Description=Tuti daily core database and journal object backup
After=network-online.target pkg-ContainerManager-dockerd.service
OnFailure=tuti-legal-job-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tuti-prod-backup --core
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
