[Unit]
Description=Tuti privacy retention and withdrawal cleanup
After=network-online.target pkg-ContainerManager-dockerd.service
OnFailure=tuti-legal-job-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tuti-privacy-data-maintain --apply
TimeoutStartSec=300
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
