#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
target="${1:-dev}"

cd "$project_dir"

case "$target" in
  dev)
    docker compose -f docker-compose.dev.yml exec -T app \
      su node -c "pnpm transport:hubs:sync"
    ;;
  prod)
    docker compose \
      --env-file .env.production \
      -f docker-compose.prod.yml \
      build ops
    docker compose \
      --env-file .env.production \
      -f docker-compose.prod.yml \
      run --rm --no-deps ops \
      pnpm transport:hubs:sync
    ;;
  *)
    echo "사용법: tuti-transport-hubs-sync [dev|prod]" >&2
    exit 1
    ;;
esac
