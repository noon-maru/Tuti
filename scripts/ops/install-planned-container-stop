#!/bin/sh
set -eu
case "$#:$*" in 0:) apply=false ;; 1:--apply) apply=true ;; *) exit 1 ;; esac
project_dir=/var/services/homes/Tutiadmin/source/Tuti
project_dir="$(CDPATH= cd -- "$project_dir" && pwd -P)"
cd "$project_dir"
tools="tuti-planned-container-stop tuti-prod-backup tuti-prod-deploy tuti-prod-rollback tuti-ops-workers"
for tool in $tools; do
  sh -n "scripts/ops/$tool"
  if [ -L "/usr/local/sbin/$tool" ]; then echo "심볼릭 링크 설치 대상은 교체하지 않습니다." >&2; exit 1; fi
  if [ "$apply" = true ]; then
    git -c safe.directory="$project_dir" ls-files --error-unmatch "scripts/ops/$tool" >/dev/null
    git -c safe.directory="$project_dir" diff --quiet HEAD -- "scripts/ops/$tool"
  fi
done
if [ "$apply" != true ]; then echo "문법 검사 완료. 커밋 후 root로 --apply 실행 시에만 설치합니다."; exit 0; fi
if [ "$(id -u)" != 0 ]; then echo "NAS 관리자 권한이 필요합니다." >&2; exit 1; fi
# Check the installed DSM interface before replacing any tool. Does not stop a container.
sh scripts/ops/tuti-planned-container-stop --check
exec 9>"$project_dir/.ops-state/maintenance.lock"
/usr/bin/flock --exclusive 9
snapshot="$project_dir/.ops-state/planned-stop-tools/$(date +%Y%m%d-%H%M%S)-$$"
install -d -o root -g root -m 0700 "$snapshot"
for tool in $tools; do
  if [ -f "/usr/local/sbin/$tool" ]; then cp -p "/usr/local/sbin/$tool" "$snapshot/$tool"; fi
done
for tool in $tools; do install -o root -g root -m 0750 "scripts/ops/$tool" "/usr/local/sbin/$tool"; done
echo "계획 중지 도구 설치 완료. 컨테이너·예약·알림 설정은 변경하지 않았습니다. 이전 도구: $snapshot"
