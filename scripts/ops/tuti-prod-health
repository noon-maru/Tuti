#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
state_dir="$project_dir/.ops-state/health"
maintenance_dir="$project_dir/.ops-state/maintenance"
maintenance_lock_file="$project_dir/.ops-state/maintenance.lock"
timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="$state_dir/$timestamp.log"
disk_warning_percent="${TUTI_DISK_WARNING_PERCENT:-85}"

install -d -o root -g root -m 0700 "$state_dir"
cd "$project_dir"

exec 9>"$maintenance_lock_file"
if ! /usr/bin/flock --shared --nonblock 9; then
  printf 'checked_at=%s\nstatus=maintenance\n' "$(date -Iseconds)" > "$log_file"
  cat "$log_file"
  exit 0
fi

if [ -d "$maintenance_dir" ]; then
  maintenance_active=false
  for marker in "$maintenance_dir"/*; do
    [ -f "$marker" ] || continue
    marker_pid="${marker##*/}"
    case "$marker_pid" in
      *[!0-9]* | "")
        rm -f "$marker"
        ;;
      *)
        if kill -0 "$marker_pid" 2>/dev/null; then
          maintenance_active=true
        else
          rm -f "$marker"
        fi
        ;;
    esac
  done

  if [ "$maintenance_active" = true ]; then
    printf 'checked_at=%s\nstatus=maintenance\n' "$(date -Iseconds)" > "$log_file"
    cat "$log_file"
    exit 0
  fi
fi

notify_failure() {
  message="Tuti 운영 상태 점검 실패: $timestamp. 로그: $log_file"
  echo "$message" >&2

  if [ -n "${TUTI_OPERATIONS_ALERT_WEBHOOK_URL:-}" ] && command -v curl >/dev/null 2>&1; then
    escaped_message="$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    curl --fail --silent --show-error \
      -H 'Content-Type: application/json' \
      --data "{\"text\":\"$escaped_message\"}" \
      "$TUTI_OPERATIONS_ALERT_WEBHOOK_URL" >/dev/null || true
  fi
}

run_checks() {
  echo "checked_at=$(date -Iseconds)"
  echo "운영 Compose 상태"
  docker compose --env-file .env.production -f docker-compose.prod.yml ps \
    || return 1

  echo "PostgreSQL 준비 상태"
  docker compose --env-file .env.production -f docker-compose.prod.yml \
    exec -T db sh -lc 'exec pg_isready --username "$POSTGRES_USER" --dbname "$POSTGRES_DB"' \
    || return 1

  echo "Next.js liveness"
  docker compose --env-file .env.production -f docker-compose.prod.yml \
    exec -T app node -e \
    'fetch("http://127.0.0.1:3000/api/health?scope=liveness").then(async response => { const body = await response.text(); console.log(`status=${response.status}`); if (response.headers.get("content-type")?.includes("application/json")) console.log(body.slice(0, 1000)); if (!response.ok) process.exit(1); }).catch(error => { console.error(error.message); process.exit(1); })' \
    || return 1

  echo "애플리케이션 readiness"
  docker compose --env-file .env.production -f docker-compose.prod.yml \
    exec -T app node -e \
    'fetch("http://127.0.0.1:3000/api/health").then(async response => { const body = await response.text(); console.log(`status=${response.status}`); if (response.headers.get("content-type")?.includes("application/json")) console.log(body.slice(0, 1000)); if (!response.ok) process.exit(1); }).catch(error => { console.error(error.message); process.exit(1); })' \
    || return 1

  if command -v curl >/dev/null 2>&1; then
    echo "공개 도메인 TLS·Cloudflare 경로"
    curl --fail --silent --show-error --max-time 15 \
      https://tuti.today/api/health \
      || return 1
    echo
  fi

  echo "스토리지 Compose 상태"
  docker compose --env-file .env.storage -f docker-compose.storage.yml ps \
    || return 1
  storage_health="$(docker inspect tuti-storage --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' 2>/dev/null)" \
    || return 1
  echo "garage_health=$storage_health"
  [ "$storage_health" = healthy ] || return 1

  echo "백업·스토리지 볼륨 사용률"
  for path in /volume1/tuti/backups /volume1/tuti/object-storage; do
    [ -e "$path" ] || continue
    usage="$(df -P "$path" | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')"
    echo "$path=${usage}%"
    if [ "$usage" -ge "$disk_warning_percent" ]; then
      echo "디스크 사용률 경고: $path ${usage}%" >&2
      return 1
    fi
  done
}

if run_checks > "$log_file" 2>&1; then
  cat "$log_file"
  find "$state_dir" -type f -name '*.log' -mtime +30 -delete
  exit 0
fi

cat "$log_file" >&2
notify_failure
exit 1
