#!/bin/sh

set -eu

project_dir="/var/services/homes/Tutiadmin/source/Tuti"

cd "$project_dir"

echo "개발 컨테이너 실행 상태 확인"
docker compose -f docker-compose.dev.yml up -d db app

echo "Prisma 클라이언트와 마이그레이션 확인"
docker compose -f docker-compose.dev.yml exec -T app pnpm db:generate
docker compose -f docker-compose.dev.yml exec -T app pnpm db:deploy

echo "자동 회귀 테스트 실행"
docker compose -f docker-compose.dev.yml exec -T app pnpm test

echo "기록 웹 공개 DB 통합 검증 실행"
docker compose -f docker-compose.dev.yml exec -T \
  -e TUTI_INSPECTION_ENV=development \
  -e NEXT_PUBLIC_JOURNAL_PUBLICATION_ENABLED=true \
  -e NEXT_PUBLIC_JOURNAL_PUBLICATION_AUDIENCE=internal \
  app pnpm journal:publication:verify

echo "ESLint 정적 검사 실행"
docker compose -f docker-compose.dev.yml exec -T app pnpm lint

echo "Tuti 개발 코드 검증을 완료했습니다."
