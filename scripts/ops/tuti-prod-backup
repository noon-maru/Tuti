#!/bin/sh

set -eu

backup_scope=full
case "$#:$*" in 0:) ;; 1:--core) backup_scope=core ;; *) echo "사용법: tuti-prod-backup [--core]" >&2; exit 1 ;; esac

project_dir="/var/services/homes/Tutiadmin/source/Tuti"
project_dir="$(CDPATH= cd -- "$project_dir" && pwd -P)"
maintenance_dir="$project_dir/.ops-state/maintenance"
maintenance_marker="$maintenance_dir/$$"
parent_maintenance_marker="$maintenance_dir/$PPID"
maintenance_lock_file="$project_dir/.ops-state/maintenance.lock"
backup_root="${TUTI_FULL_BACKUP_ROOT:-/volume1/tuti/backups/full}"
if [ "$backup_scope" = core ]; then backup_root=/volume1/tuti/backups/core; fi
timestamp="$(date +%Y%m%d-%H%M%S)"
backup_dir="$backup_root/$timestamp"
temporary_dir="$backup_root/.$timestamp.partial"

case "$backup_root" in
  /volume1/tuti/backups/full | /volume1/tuti/backups/core | /volumeUSB*/*)
    ;;
  *)
    echo "백업 경로는 /volume1/tuti/backups/full 또는 외장 볼륨 하위여야 합니다: $backup_root" >&2
    exit 1
    ;;
esac

umask 077
if [ -L "$backup_root" ]; then echo "백업 경로에 심볼릭 링크를 사용할 수 없습니다." >&2; exit 1; fi
install -d -o root -g root -m 0700 "$backup_root"
install -d -o root -g root -m 0700 "$maintenance_dir"
if [ "$backup_scope" = core ]; then
  cd "$project_dir"
  for source in scripts/ops/core-backup-production-guard.sql scripts/ops/core-backup-excluded-data-tables.txt; do
    git -c safe.directory="$project_dir" ls-files --error-unmatch "$source" >/dev/null 2>&1
    git -c safe.directory="$project_dir" diff --quiet HEAD -- "$source"
  done
fi

# 배포 스크립트가 이미 유지보수 잠금을 잡은 상태에서 이 백업을 호출할 수 있습니다.
# 일부 셸은 exec 시 9번 파일 디스크립터를 닫으므로 FD 경로만 비교하면 자가 교착이
# 발생합니다. 직속 부모의 배포 마커도 함께 확인해 중첩 잠금을 피합니다.
parent_holds_maintenance_lock=false
if [ -r "$parent_maintenance_marker" ] \
  && [ "$(cat "$parent_maintenance_marker" 2>/dev/null || true)" = "deploy" ]; then
  parent_holds_maintenance_lock=true
fi

if [ "$parent_holds_maintenance_lock" != true ]; then
  if [ "$(readlink "/proc/$$/fd/9" 2>/dev/null || true)" != "$maintenance_lock_file" ]; then
    exec 9>"$maintenance_lock_file"
  fi
  /usr/bin/flock --exclusive 9
fi
if [ -f "$project_dir/.ops-state/restore-privacy/pending.env" ] || [ -f "$project_dir/.ops-state/privacy-activation/pending" ]; then
  echo "DB 복원 후 개인정보 확인 대기 중입니다. 재정리 전 새 백업을 만들지 않습니다." >&2
  exit 1
fi
if [ -e "$temporary_dir" ] || [ -e "$backup_dir" ]; then echo "동일 시각의 백업이 이미 존재합니다." >&2; exit 1; fi
printf 'backup\n' > "$maintenance_marker"
chmod 0600 "$maintenance_marker"
install -d -o root -g root -m 0700 "$temporary_dir"
app_was_running="$(docker inspect tuti-prod --format '{{.State.Running}}')"
case "$app_was_running" in true | false) ;; *) echo "앱의 실행 상태를 확인하지 못했습니다. 중지하지 않습니다." >&2; exit 1 ;; esac
# 같은 컨테이너만 재개한다. Compose 재생성·env 재적용·이미지 교체는 백업의 역할이 아니다.
app_identity_before="$(docker inspect tuti-prod --format '{{.Id}}|{{.Image}}')"
case "$app_identity_before" in ?*\|?*) ;; *) echo "앱의 컨테이너 식별값을 확인하지 못했습니다." >&2; exit 1 ;; esac
app_container_id="${app_identity_before%%|*}"
recovery_required=false
recovery_attempt=1

# Deploy may export the NEXT ops image. Backup must use the CURRENT deployed worker
# (before migrations), not replace it while holding the maintenance lock.
backup_worker() { TUTI_OPS_IMAGE=tuti:ops /usr/local/sbin/tuti-ops-workers "$@"; }
wait_for_app_ready() {
  attempt=1
  while [ "$attempt" -le 12 ]; do
    if curl --fail --silent --show-error --connect-timeout 3 --max-time 5 \
      http://127.0.0.1:5050/api/health </dev/null >/dev/null 2>&1; then return 0; fi
    sleep 2
    attempt=$((attempt + 1))
  done
  echo "백업 후 앱 readiness를 확인하지 못했습니다. 백업 사본과 별도로 서비스 복구를 점검해주세요." >&2
  return 1
}

restore_original_app() {
  [ "$recovery_required" = true ] || return 0
  if [ -f "$project_dir/.ops-state/restore-privacy/pending.env" ] || [ -f "$project_dir/.ops-state/privacy-activation/pending" ]; then
    echo "개인정보 복원·전환 확인 대기 상태이므로 앱을 자동 재개하지 않습니다." >&2
    return 1
  fi
  while [ "$recovery_attempt" -le 3 ]; do
    if ! current_identity="$(timeout 10 docker inspect tuti-prod --format '{{.Id}}|{{.Image}}' 2>/dev/null)"; then
      echo "백업 앱 복구 단계 실패: stage=identity-read" >&2
      return 1
    fi
    if [ "$current_identity" != "$app_identity_before" ]; then
      echo "백업 중 앱 컨테이너가 교체됐습니다. 다른 컨테이너를 자동 기동하지 않습니다." >&2
      return 1
    fi
    recovery_attempt=$((recovery_attempt + 1))
    if timeout 30 docker start "$app_container_id" >/dev/null 2>&1; then
      if wait_for_app_ready; then
        echo "백업 후 기존 앱 재기동·readiness 확인 완료."
        recovery_required=false
        return 0
      fi
      echo "백업 앱 복구 단계 실패: stage=readiness" >&2
    else
      start_status=$?
      printf '백업 앱 복구 단계 실패: stage=container-start exit=%s\n' "$start_status" >&2
    fi
    echo "백업 후 기존 앱 복구 실패: $((recovery_attempt - 1))/3" >&2
  done
  return 1
}

cleanup() {
  original_status=$?
  trap - EXIT INT TERM HUP
  # EXIT 복구 자체는 errexit으로 중단되지 않아야 한다. 오류는 명시적으로 전파한다.
  set +e
  if ! restore_original_app; then
    echo "백업 후 앱 자동 복구에 실패했습니다. 운영 앱을 즉시 점검해주세요. 백업 성공으로 처리하지 않습니다." >&2
    logger -p daemon.err -t tuti-backup "Tuti backup app recovery failed; operator action required." 2>/dev/null
    original_status=20
  fi
  rm -rf "$temporary_dir"
  rm -f "$maintenance_marker"
  exit "$original_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cd "$project_dir"

command -v curl >/dev/null
command -v timeout >/dev/null
backup_worker backup-check "$backup_scope" "$timestamp"

if [ "$app_was_running" = true ]; then
  echo "DB와 객체의 동일 시점 백업을 위해 운영 앱 쓰기를 잠시 중지합니다."
  # DSM 요청이 실패/시간 초과해도 실제 중지는 일어날 수 있다. 호출 전에 복구를 예약한다.
  recovery_required=true
  sh "$project_dir/scripts/ops/tuti-planned-container-stop" tuti-prod
fi

echo "완료된 삭제 요청의 잔존 객체 점검·정리"
backup_worker backup-cleanup

set --
if [ "$backup_scope" = core ]; then
  echo "핵심 백업 제외 정책·외래키 의존성 검사"
  if ! docker compose --env-file .env.production -f docker-compose.prod.yml exec -T db \
    sh -c 'exec psql --no-psqlrc -q -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1' \
    < scripts/ops/core-backup-production-guard.sql >/dev/null 2>&1; then
    echo "핵심 백업 정책 검증에 실패했습니다. 전체 백업은 기존 방식으로 유지합니다." >&2; exit 1
  fi
  while IFS= read -r table; do
    case "$table" in "" | *[!a-z_]*) echo "잘못된 핵심 백업 정책입니다." >&2; exit 1 ;; esac
    set -- "$@" "--exclude-table-data=public.$table"
  done < scripts/ops/core-backup-excluded-data-tables.txt
  cp scripts/ops/core-backup-excluded-data-tables.txt "$temporary_dir/excluded-data-tables.txt"
fi
echo "운영 PostgreSQL 백업: $backup_scope"
docker compose \
  --env-file .env.production \
  -f docker-compose.prod.yml \
  exec -T db \
  sh -c 'exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format=custom --compress=6 --no-owner --no-privileges "$@"' sh "$@" \
  > "$temporary_dir/postgres.dump"

if [ ! -s "$temporary_dir/postgres.dump" ]; then
  echo "PostgreSQL 백업 파일이 비어 있습니다." >&2
  exit 1
fi

echo "Garage 오브젝트 논리 백업"
backup_worker backup-objects "$backup_scope" "$timestamp"

# 명령이 성공해도 지정한 마운트에 결과물이 없으면 완전한 백업으로 확정하지 않는다.
if [ ! -s "$temporary_dir/objects.manifest.json" ] || [ ! -d "$temporary_dir/objects" ]; then
  echo "지정한 백업 경로에 객체 목록·디렉터리가 없습니다. 완전한 백업으로 확정하지 않습니다." >&2
  exit 1
fi

schema_migrations="$temporary_dir/migrations.txt"
find prisma/migrations -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
  | sort > "$schema_migrations" || true

cat > "$temporary_dir/manifest.txt" <<EOF
backup_version=1
created_at=$(date -Iseconds)
git_revision=$(git -c safe.directory="$project_dir" rev-parse HEAD 2>/dev/null || printf unknown)
database=production-$backup_scope-custom-dump
backup_scope=$backup_scope
object_storage=logical-s3-object-copy
secrets_included=false
restore_scope=database-and-journal-objects
EOF

(
  cd "$temporary_dir"
  find . -type f ! -name checksums.sha256 -print0 \
    | sort -z \
    | xargs -0 sha256sum > checksums.sha256
  if ! sha256sum -c checksums.sha256 >/dev/null 2>&1; then
    echo "백업 파일 무결성 확인에 실패했습니다. 객체 키·본문은 출력하지 않습니다." >&2; exit 1
  fi
)

mv "$temporary_dir" "$backup_dir"

restore_original_app || exit 20
rm -f "$maintenance_marker"
trap - EXIT INT TERM HUP

# 파기는 두 백업 경로와 삭제 원장을 함께 검토하는 전용 예약 작업에서만 수행한다.

echo "운영 $backup_scope 백업 완료: $backup_dir"
echo "주의: 이 백업은 같은 NAS에 있습니다. Hyper Backup으로 원격지 또는 외장 장치에 다시 복제하세요."
