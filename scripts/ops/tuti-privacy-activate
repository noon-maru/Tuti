#!/bin/sh
set -eu
PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
export PATH
if [ "$#:$*" != "1:--apply" ] || [ "$(id -u)" != 0 ]; then
  echo "사용법: sudo sh scripts/ops/tuti-privacy-activate --apply (실제 원장·파기 자동화 전환)" >&2; exit 1
fi
project_dir="/var/services/homes/Tutiadmin/source/Tuti"
cd "$project_dir"
if [ -n "$(git -c safe.directory="$project_dir" status --porcelain)" ]; then echo "변경분을 먼저 검토·커밋해주세요." >&2; exit 1; fi
release="$(git -c safe.directory="$project_dir" rev-parse --short=12 HEAD)"
app_release="$(docker inspect tuti-prod --format '{{range .Config.Env}}{{println .}}{{end}}' | sed -n 's/^TUTI_RELEASE=//p')"
if [ "$app_release" != "$release" ]; then echo "현재 커밋의 운영 배포가 먼저 필요합니다." >&2; exit 1; fi
image="$(docker inspect tuti-prod --format '{{.Config.Image}}')"
case "$image" in tuti:prod-*) ;; *) echo "운영 이미지 확인 필요" >&2; exit 1 ;; esac
sh scripts/ops/install-legal-compliance-tools --apply
sh scripts/ops/install-legal-compliance-timers --apply
install -d -o root -g root -m 0700 "$project_dir/.ops-state/privacy-activation" "$project_dir/.ops-state/privacy-recovery"
exec 9>"$project_dir/.ops-state/maintenance.lock"
/usr/bin/flock --exclusive --nonblock 9 || { echo "다른 유지보수 작업이 실행 중입니다." >&2; exit 1; }
if [ -f "$project_dir/.ops-state/restore-privacy/pending.env" ]; then echo "복원 확인 대기 건이 있습니다." >&2; exit 1; fi
compose() { docker compose --env-file .env.production -f docker-compose.prod.yml "$@"; }
ops() { compose run --rm --no-deps -T --user 1000:1000 -e PRIVACY_REPLAY_LEDGER_ENABLED=true -e TUTI_PRIVACY_REPLAY_OFFLINE=true ops node_modules/.bin/tsx scripts/privacy-replay.ts "$@"; }
backup() { compose run --rm --no-deps -T --user 0:0 -e PRIVACY_REPLAY_LEDGER_ENABLED=true -v "$project_dir/.ops-state/privacy-recovery:/recovery" ops node_modules/.bin/tsx scripts/privacy-ledger-recovery.ts --snapshot; }
pending="$project_dir/.ops-state/privacy-activation/pending"
coverage_mode="$(ops --coverage-mode)"
app_flag="$(docker inspect tuti-prod --format '{{range .Config.Env}}{{println .}}{{end}}' | sed -n 's/^PRIVACY_REPLAY_LEDGER_ENABLED=//p')"
if [ "$coverage_mode" = active ] && [ "$app_flag" != true ] && [ ! -f "$pending" ]; then
  echo "활성화 이력이 있으나 앱 기록 기능이 꺼져 있습니다. 새 수집 공백을 수동 검토해야 합니다." >&2; exit 1
fi
case "$coverage_mode" in active | unactivated) ;; *) echo "원장 수집 상태 확인 실패" >&2; exit 1 ;; esac
# 중단·실패 후에는 운영자가 같은 도구로 재시도한다. 환경 플래그를 꺼서 우회하지 않는다.
if [ -f "$pending" ] && [ "$(docker inspect tuti-prod --format '{{.State.Running}}')" = true ]; then
  echo "전환 확인 대기 중 실행된 앱이 있습니다. 수집 공백 수동 검토가 필요합니다." >&2; exit 1
fi
ops --status
backup
printf 'release=%s\nstarted_at=%s\n' "$release" "$(date -Iseconds)" > "$pending"
chmod 0600 "$pending"
complete=false
cleanup() {
  if [ "$complete" != true ]; then
    docker stop tuti-prod >/dev/null 2>&1 || true
    docker update --restart=no tuti-prod >/dev/null 2>&1 || true
    echo "전환 확인 대기를 유지합니다. 키·원장·플래그를 되돌리지 말고 운영 점검이 필요합니다." >&2
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
docker stop tuti-prod
docker update --restart=no tuti-prod
ops "--activate-coverage=PRIVACY-CUTOVER-$release"
compose run --rm --no-deps -T --user 0:0 -v "$project_dir:/runtime-config" ops node_modules/.bin/tsx scripts/enable-privacy-ledger-config.ts
backup
TUTI_APP_IMAGE="$image" TUTI_RELEASE="$release" docker compose --env-file .env.production -f docker-compose.prod.yml create --no-deps app
docker update --restart=no tuti-prod
docker start tuti-prod
ready=false
attempt=1
while [ "$attempt" -le 12 ]; do
  if docker exec tuti-prod node -e 'fetch("http://127.0.0.1:3000/api/health").then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))'; then ready=true; break; fi
  sleep 5
  attempt=$((attempt + 1))
done
if [ "$ready" != true ]; then echo "운영 readiness 확인 실패" >&2; exit 1; fi
# 앱 자체의 UID·키·마운트로 서명을 대조한다. 키·원문·검증값은 출력하지 않는다.
docker exec tuti-prod node -e '
const fs=require("fs"), crypto=require("crypto");
if(process.env.PRIVACY_REPLAY_LEDGER_ENABLED!=="true")process.exit(1);
const e=JSON.parse(fs.readFileSync("/run/tuti/privacy-ledger/ledger.json","utf8"));
const s=crypto.createHmac("sha256",Buffer.from(process.env.PRIVACY_REPLAY_HMAC_SECRET,"hex")).update(e.payload).digest("hex");
if(s!==e.signature||!JSON.parse(e.payload).activatedAt)process.exit(1);
console.log("app_ledger_signature=ok");'
ops --status
docker update --restart=unless-stopped tuti-prod
mv "$pending" "$project_dir/.ops-state/privacy-activation/completed-$release"
complete=true
trap - EXIT INT TERM
# 잠금을 풀고 세 가지 개인정보 작업만 시작한다. 권리 침해·민감정보·약관 플래그는 켜지 않는다.
/usr/bin/flock --unlock 9
systemctl start tuti-privacy-ledger-backup.service
systemctl start tuti-privacy-maintenance.service
systemctl start tuti-backup-retention.service
systemctl enable tuti-privacy-maintenance.timer tuti-privacy-ledger-backup.timer tuti-backup-retention.timer
systemctl start tuti-privacy-maintenance.timer tuti-privacy-ledger-backup.timer tuti-backup-retention.timer
systemctl list-timers --all --no-pager
echo "원장·로컬 복구 사본·개인정보 정기 파기 활성화 완료. 약관 공고·시행과 권리 업무 전환은 미실행."
