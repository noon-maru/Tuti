# =============================================================================
# Tuti 공통 환경변수 예제
# =============================================================================
# 개발·운영 서버가 함께 읽는 설정입니다. 환경별 재정의는 각 환경 예제에서 관리합니다.
# 스토어 업데이트 정책은 .env.production.example, 앱 빌드 공개 설정은 Actions에서 관리합니다.


# -----------------------------------------------------------------------------
# 런타임·개발 컨테이너
# -----------------------------------------------------------------------------
# Next.js 원격 telemetry를 비활성화합니다.
NEXT_TELEMETRY_DISABLED=1
# 개발 컨테이너의 바인드 마운트 권한에 사용할 호스트 UID·GID입니다.
DEV_UID=1000
DEV_GID=1000


# -----------------------------------------------------------------------------
# 계정·이메일 로그인
# -----------------------------------------------------------------------------
# 서버 인증 기능과 인증코드 HMAC 서명키입니다.
ACCOUNT_AUTH_ENABLED=false
AUTH_EMAIL_CODE_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_PROVIDER=daum-smartwork
AUTH_EMAIL_FROM=Tuti <admin@tuti.today>

# 스마트워크에 연결된 Daum 메일 주소와 2단계 인증용 앱 비밀번호입니다.
DAUM_SMTP_USER=your-daum-id@daum.net
DAUM_SMTP_APP_PASSWORD=replace-with-daum-app-password


# -----------------------------------------------------------------------------
# 심사용 비밀번호 로그인
# -----------------------------------------------------------------------------
# 외부 메일함 없이 로그인할 심사용 이메일과 8~128자 비밀번호입니다.
AUTH_APP_REVIEW_EMAIL=
AUTH_APP_REVIEW_PASSWORD=


# -----------------------------------------------------------------------------
# 소셜 로그인 공통
# -----------------------------------------------------------------------------
# false이면 공급자별 설정과 관계없이 소셜 OAuth를 일괄 차단합니다.
SOCIAL_OAUTH_ENABLED=false
# OAuth 콜백을 생성할 공개 서버 주소입니다.
AUTH_PUBLIC_BASE_URL=https://tuti.today


# -----------------------------------------------------------------------------
# Apple 로그인
# -----------------------------------------------------------------------------
APPLE_OAUTH_ENABLED=false
# 웹 OAuth에는 App ID가 아니라 연결된 Services ID를 사용합니다.
APPLE_CLIENT_ID=com.noonmaru.tuti.apple.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 PEM 전체를 사용하며 한 줄 값의 줄바꿈은 \n으로 표현할 수 있습니다.
APPLE_PRIVATE_KEY=
# Apple refresh token 암호화 키입니다. openssl rand -base64 32로 생성합니다.
APPLE_TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Google 로그인
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Kakao 로그인·지도
# -----------------------------------------------------------------------------
KAKAO_OAUTH_ENABLED=false
# 카카오 로그인·지도·자동차 길찾기가 함께 사용하는 REST API 키입니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# PNG 공유·하루마디 PDF 서명
# -----------------------------------------------------------------------------
# 비워두면 각각 AUTH_EMAIL_CODE_SECRET을 도메인 분리해 대신 사용합니다.
MADI_SHARE_TRACE_SECRET=replace-with-at-least-32-random-characters
HARUMADI_PDF_APPROVAL_SECRET=replace-with-at-least-32-random-characters


# -----------------------------------------------------------------------------
# 기록 웹 공개
# -----------------------------------------------------------------------------
# 웹 공개 기능과 대상입니다. internal은 관리자, public은 로그인 계정 대상입니다.
# 실제 공개에는 별도 정책 동의와 서버 검증이 적용됩니다.
NEXT_PUBLIC_MADI_PUBLICATION_ENABLED=false
NEXT_PUBLIC_MADI_PUBLICATION_AUDIENCE=internal


# -----------------------------------------------------------------------------
# 위치정보 외부 처리·감사
# -----------------------------------------------------------------------------
# pending은 외부 좌표 전달 차단, processor는 처리위탁, third_party는 제3자 제공 모드입니다.
# 현행 운영 판단은 processor이며 별도 제공 절차가 없는 third_party는 전달을 차단합니다.
LOCATION_EXTERNAL_COORDINATE_MODE=pending
# 위치 감사 HMAC 키입니다. 비워두면 AUTH_EMAIL_CODE_SECRET을 도메인 분리해 사용합니다.
LOCATION_AUDIT_HMAC_SECRET=replace-with-at-least-32-random-characters


# -----------------------------------------------------------------------------
# 트래픽 보안
# -----------------------------------------------------------------------------
# 가명 트래픽 식별·수동 차단과 전용 HMAC 키입니다.
TRAFFIC_SECURITY_ENABLED=true
TRAFFIC_SECURITY_HMAC_SECRET=replace-with-at-least-32-random-characters


# -----------------------------------------------------------------------------
# 마디 이미지 오브젝트 스토리지
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_REGION=tuti
OBJECT_STORAGE_BUCKET=tuti-journal-images
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# Android 서버 푸시·Firebase Cloud Messaging
# -----------------------------------------------------------------------------
FCM_PUSH_ENABLED=false
# 전체 발송이 false일 때만 아래 이메일 계정의 등록·발송을 예외 허용합니다. 쉼표로 구분합니다.
FCM_PUSH_TEST_EMAILS=
# Firebase 서비스 계정 JSON의 호스트 경로입니다.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/var/services/homes/Tutiadmin/.tuti-secrets/firebase/tuti-push-sender.json


# -----------------------------------------------------------------------------
# iOS 서버 푸시·Apple Push Notification service
# -----------------------------------------------------------------------------
APNS_PUSH_ENABLED=false
# 전체 발송이 false일 때만 아래 이메일 계정의 등록·발송을 예외 허용합니다.
APNS_PUSH_TEST_EMAILS=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.noonmaru.tuti
# TestFlight·App Store는 production을 사용합니다.
APNS_ENVIRONMENT=production
APNS_PRIVATE_KEY_HOST_PATH=/var/services/homes/Tutiadmin/.tuti-secrets/apple/tuti-apns-auth-key.p8


# -----------------------------------------------------------------------------
# 비밀 파일 마운트 권한
# -----------------------------------------------------------------------------
# 컨테이너 사용자의 키 파일 열람에 필요한 호스트 그룹 GID입니다.
# Synology administrators 기본값은 101이며 getent group administrators로 확인합니다.
TUTI_SECRET_GID=101


# -----------------------------------------------------------------------------
# 관광·날씨 공공데이터
# -----------------------------------------------------------------------------
# 공공데이터포털의 통합 개인 API 인증키(Decoding)입니다. 한국관광공사·TAGO 등에 사용합니다.
DATA_GO_KR_API_KEY=replace-with-data-go-kr-api-key
# 기상청 단기예보 전용 키입니다. 비워두면 DATA_GO_KR_API_KEY를 사용합니다.
KMA_WEATHER_API_KEY=
# 서울 열린데이터광장 실시간 인구데이터 키입니다.
SEOUL_OPEN_DATA_API_KEY=replace-with-seoul-open-data-api-key


# -----------------------------------------------------------------------------
# 공개 장소 AI 전처리
# -----------------------------------------------------------------------------
# 공개 장소 정보만 비동기 구조화합니다. 추천 요청 중 호출하거나 사용자 기록을 전송하지 않습니다.
OPENAI_API_KEY=sk-example-tuti-openai-key
# 미지정 시 gpt-4o-mini를 사용합니다.
OPENAI_PROFILE_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# 추천 개인화·사용자 AI
# -----------------------------------------------------------------------------
# off는 프로필 미조회, shadow는 비교 순위 기록, active는 순위 반영 모드입니다.
TUTI_PERSONALIZATION_MODE=off
# 사용자 행동의 외부 AI 전송 기능은 비활성화합니다.
TUTI_USER_AI_PROFILING_ENABLED=false


# -----------------------------------------------------------------------------
# 약관 공개·동의·시행
# -----------------------------------------------------------------------------
# 일반약관 조회·동의 기능과 미동의 일반 API 제한을 각각 제어합니다.
SERVICE_TERMS_WORKFLOW_ENABLED=false
SERVICE_TERMS_ENFORCEMENT_ENABLED=false
# 승인된 법적 문서 버전과 실제 시행 시각(시간대 포함 ISO 8601)입니다.
TUTI_LEGAL_POLICY_RELEASE=
TUTI_LEGAL_POLICY_EFFECTIVE_AT=


# -----------------------------------------------------------------------------
# 공개 기록 권리 보호
# -----------------------------------------------------------------------------
# 권리 침해 사건·통지 기한 관리와 운영 알림 웹훅입니다.
LEGAL_RIGHTS_WORKFLOW_ENABLED=false
LEGAL_RIGHTS_ALERT_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# 삭제·철회 복원 방지 원장
# -----------------------------------------------------------------------------
# 백업 복원 시 삭제·철회를 재이행하는 원장과 HMAC 서명키입니다.
PRIVACY_REPLAY_LEDGER_ENABLED=false
PRIVACY_REPLAY_HMAC_SECRET=
# 컨테이너 내부 경로와 NAS 호스트 경로입니다.
PRIVACY_REPLAY_LEDGER_PATH=/run/tuti/privacy-ledger
TUTI_PRIVACY_LEDGER_HOST_PATH=/var/services/homes/Tutiadmin/.tuti-secrets/privacy-ledger


# -----------------------------------------------------------------------------
# 개인정보 보관기한 정리
# -----------------------------------------------------------------------------
# 완료 문의 3년·미완료 PNG 추적 30일·전용 일반 오류 1년 정리입니다.
PRIVACY_EXTENDED_RETENTION_ENABLED=false


# -----------------------------------------------------------------------------
# 민감정보 기록 보호
# -----------------------------------------------------------------------------
# 서버의 기존 자료 보호·동의·철회 경로입니다. 현재 작성 UI는 민감정보 입력을 제공하지 않습니다.
SENSITIVE_MADI_WORKFLOW_ENABLED=false

# 함께 채우기: DB·앱·신고/차단 검증 후 활성화합니다.
HARUMADI_TOGETHER_ENABLED=false
