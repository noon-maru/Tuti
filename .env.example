# -----------------------------------------------------------------------------
# 공통 런타임 설정
# -----------------------------------------------------------------------------
# 모든 Next.js 실행 환경에서 원격 telemetry 전송을 끕니다.
NEXT_TELEMETRY_DISABLED=1

# 개발 컨테이너가 바인드 마운트 파일을 같은 사용자로 다루도록 호스트의
# `id -u`, `id -g` 결과를 설정합니다.
DEV_UID=1000
DEV_GID=1000


# -----------------------------------------------------------------------------
# 계정 인증 서버 설정
# -----------------------------------------------------------------------------
# 공급자 키와 콜백 검증 구현이 완료될 때까지 반드시 false로 유지합니다.
ACCOUNT_AUTH_ENABLED=false

# 이메일 인증코드 원문을 저장하지 않고 HMAC 해시할 서버 전용 비밀값입니다.
AUTH_EMAIL_CODE_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_PROVIDER=daum-smartwork
AUTH_EMAIL_FROM=Tuti <admin@tuti.today>

# App Review가 외부 메일함 없이 로그인할 수 있는 비만료 심사용 자격증명입니다.
# 두 값을 모두 비우면 비활성화됩니다. 한 값만 설정하면 인증 요청을 차단합니다.
# 활성화할 때 코드는 숫자 6자리여야 하며,
# 저장소에 실제 운영값을 커밋하지 말고 App Review Information에만 제공합니다.
AUTH_APP_REVIEW_EMAIL=
AUTH_APP_REVIEW_CODE=

# 공유 PNG 추적 정보의 HMAC 서명에 사용하는 서버 전용 비밀값입니다.
# 비워두면 AUTH_EMAIL_CODE_SECRET을 도메인 분리해 대신 사용합니다.
JOURNAL_SHARE_TRACE_SECRET=replace-with-at-least-32-random-characters

# Daum 스마트워크 SMTP는 연결된 Daum 메일 주소와 2단계 인증에서 발급한
# 앱 비밀번호로 인증합니다. 스마트워크 주소(admin@tuti.today)가 아니라
# 스마트워크에 연결된 Daum 메일 주소를 사용합니다.
DAUM_SMTP_USER=your-daum-id@daum.net
DAUM_SMTP_APP_PASSWORD=replace-with-daum-app-password

# OAuth 콜백 URL을 생성할 공개 서버 주소입니다.
AUTH_PUBLIC_BASE_URL=https://tuti.today

APPLE_OAUTH_ENABLED=false
# 웹 OAuth에는 App ID가 아니라 연결된 Services ID를 사용합니다.
APPLE_CLIENT_ID=com.noonmaru.tuti.apple.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 PEM 전체를 넣습니다. 한 줄 환경변수에서는 줄바꿈을 \\n으로 표현할 수 있습니다.
APPLE_PRIVATE_KEY=
# `openssl rand -base64 32`로 생성한 Apple refresh token 암호화 키입니다.
APPLE_TOKEN_ENCRYPTION_KEY=

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_OAUTH_ENABLED=false
# 카카오 로그인, 카카오맵 REST API, 카카오내비 길찾기에 함께 사용합니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 모든 공급자의 자격증명과 콜백을 확인한 운영 환경에서만 true로 변경합니다.
# false로 바꾸면 공급자별 설정과 관계없이 소셜 OAuth를 일괄 차단합니다.
SOCIAL_OAUTH_ENABLED=false

# 게시물 필터링·차단 체계를 갖추기 전까지 공개 웹 링크를 만들지 않습니다.
NEXT_PUBLIC_JOURNAL_PUBLICATION_ENABLED=false

# Kakao/Kakao Mobility의 현재 좌표 처리 관계가 서면으로 확정되기 전에는
# pending을 유지합니다. processor 또는 third_party는 준수 절차 완료 후 설정합니다.
LOCATION_EXTERNAL_COORDINATE_MODE=pending

# 위치정보시스템 접근·권한·점검 기록의 HMAC 무결성 서명 비밀값입니다.
# 최소 32자의 별도 난수 사용을 권장합니다. 비우면 AUTH_EMAIL_CODE_SECRET을
# 도메인 분리해 사용하지만 운영에서는 별도 값을 설정하세요.
LOCATION_AUDIT_HMAC_SECRET=replace-with-at-least-32-random-characters


# -----------------------------------------------------------------------------
# 저널 이미지 오브젝트 스토리지
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_REGION=tuti
OBJECT_STORAGE_BUCKET=tuti-journal-images
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# 서버 전용 외부 연동
# -----------------------------------------------------------------------------
# Android 서버 푸시는 Firebase Cloud Messaging HTTP v1을 사용합니다.
# 서비스 계정 JSON은 저장소 밖에 두고 호스트 경로만 설정합니다.
FCM_PUSH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/var/services/homes/Tutiadmin/.tuti-secrets/firebase/tuti-push-sender.json
# 컨테이너의 node 사용자가 위 비밀키를 읽을 수 있도록 추가할 호스트 그룹 GID입니다.
# Synology administrators 그룹의 기본값은 101이며 실제 `getent group administrators`로 확인합니다.
TUTI_SECRET_GID=101

# 공공데이터포털(data.go.kr)의 통합 개인 API 인증키(Decoding)입니다.
# 한국관광공사·TAGO 등 공공데이터포털에서 활용신청한 API가 함께 사용합니다.
# 서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
DATA_GO_KR_API_KEY=replace-with-data-go-kr-api-key

# 기상청 단기예보 전용 인증키입니다. 비워두면 위 공공데이터포털 키를 사용합니다.
# 공공데이터포털에서 단기예보 조회서비스 활용신청이 승인되어 있어야 합니다.
KMA_WEATHER_API_KEY=

# 서울 열린데이터광장 실시간 인구데이터 API 인증키입니다.
# 서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SEOUL_OPEN_DATA_API_KEY=replace-with-seoul-open-data-api-key

# 장소 의미와 누적 행동 신호를 오프라인 배치로 구조화할 OpenAI API 키입니다.
# 추천 요청 중에는 OpenAI를 호출하지 않으며 클라이언트에 노출되지 않습니다.
OPENAI_API_KEY=sk-example-tuti-openai-key

# 비동기 프로필 생성 모델입니다. 비워두면 gpt-4o-mini를 사용합니다.
OPENAI_PROFILE_MODEL=gpt-4o-mini

# off: 프로필 미조회, shadow: 결과는 유지하고 가상 순위만 기록, active: 낮은 가중치로 반영
# 사용자별 외부 AI 처리를 다시 도입하기 전까지 추천 프로필을 조회하지 않습니다.
TUTI_PERSONALIZATION_MODE=off

# 명시적 동의 기능을 마련하기 전까지 사용자 행동의 외부 AI 전송을 차단합니다.
TUTI_USER_AI_PROFILING_ENABLED=false

# 향후 이벤트 분석에 사용할 PostHog 서버 API 키입니다.
POSTHOG_API_KEY=phc_example_tuti_posthog_key
