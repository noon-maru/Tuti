# -----------------------------------------------------------------------------
# 공통 런타임 설정
# -----------------------------------------------------------------------------
# 모든 Next.js 실행 환경에서 원격 telemetry 전송을 끕니다.
NEXT_TELEMETRY_DISABLED=1

# 개발 컨테이너가 바인드 마운트 파일을 같은 사용자로 다루도록 호스트의
# `id -u`, `id -g` 결과를 설정합니다.
DEV_UID=1000
DEV_GID=1000


# -----------------------------------------------------------------------------
# 계정 인증 서버 설정
# -----------------------------------------------------------------------------
# 공급자 키와 콜백 검증 구현이 완료될 때까지 반드시 false로 유지합니다.
ACCOUNT_AUTH_ENABLED=false

# 이메일 인증코드 원문을 저장하지 않고 HMAC 해시할 서버 전용 비밀값입니다.
AUTH_EMAIL_CODE_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_PROVIDER=daum-smartwork
AUTH_EMAIL_FROM=Tuti <admin@tuti.today>

# 공유 PNG 추적 정보의 HMAC 서명에 사용하는 서버 전용 비밀값입니다.
# 비워두면 AUTH_EMAIL_CODE_SECRET을 도메인 분리해 대신 사용합니다.
JOURNAL_SHARE_TRACE_SECRET=replace-with-at-least-32-random-characters

# Daum 스마트워크 SMTP는 연결된 Daum 메일 주소와 2단계 인증에서 발급한
# 앱 비밀번호로 인증합니다. 스마트워크 주소(admin@tuti.today)가 아니라
# 스마트워크에 연결된 Daum 메일 주소를 사용합니다.
DAUM_SMTP_USER=your-daum-id@daum.net
DAUM_SMTP_APP_PASSWORD=replace-with-daum-app-password

# OAuth 콜백 URL을 생성할 공개 서버 주소입니다.
AUTH_PUBLIC_BASE_URL=https://tuti.today

APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=today.tuti.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_OAUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 저널 이미지 오브젝트 스토리지
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_REGION=tuti
OBJECT_STORAGE_BUCKET=tuti-journal-images
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# 서버 전용 외부 연동
# -----------------------------------------------------------------------------
# 한국관광공사 OpenAPI의 일반 인증키(Decoding)입니다.
# 서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
KTO_TOURISM_INFO_SERVICE_KEY=replace-with-kto-tourism-info-service-key
KTO_REGIONAL_RESOURCE_DEMAND_SERVICE_KEY=replace-with-kto-regional-resource-demand-service-key
KTO_REGIONAL_DEMAND_INTENSITY_SERVICE_KEY=replace-with-kto-regional-demand-intensity-service-key
KTO_WELLNESS_TOURISM_SERVICE_KEY=replace-with-kto-wellness-tourism-service-key
KTO_MUNICIPAL_CORE_TOURISM_SERVICE_KEY=replace-with-kto-municipal-core-tourism-service-key
KTO_TOURIST_SPOT_CONCENTRATION_RATE_SERVICE_KEY=replace-with-kto-tourist-spot-concentration-rate-service-key
KTO_REGIONAL_VISITOR_COUNT_SERVICE_KEY=replace-with-kto-regional-visitor-count-service-key

# 향후 LLM 상태 해석에 사용할 OpenAI API 키입니다. 클라이언트에 노출되지 않도록
# NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=sk-example-tuti-openai-key

# OpenAI 상태 해석에 사용할 모델입니다. 비워두면 서버 코드의 기본값을 사용합니다.
OPENAI_STATE_MODEL=gpt-4o-mini

# 향후 이벤트 분석에 사용할 PostHog 서버 API 키입니다.
POSTHOG_API_KEY=phc_example_tuti_posthog_key
