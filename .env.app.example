# Capacitor Android·iOS 앱의 정적 번들에 포함되는 공개 설정만 둡니다.
# 다른 빌드 장비에서는 이 파일을 `.env.app.local`로 복사해 사용합니다.
# `.env.app.local`은 Git에 포함되지 않습니다.

NEXT_PUBLIC_API_BASE_URL=https://tuti.today/api

NEXT_PUBLIC_ACCOUNT_AUTH_ENABLED=true
NEXT_PUBLIC_SOCIAL_OAUTH_ENABLED=true
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=true

# 1.0.0부터 공개 기록 웹 링크를 정식 제공합니다.
# 일반 계정 공개는 코드에 명시된 운영정책 시행일 이후 허용됩니다.
NEXT_PUBLIC_JOURNAL_PUBLICATION_ENABLED=true
NEXT_PUBLIC_JOURNAL_PUBLICATION_AUDIENCE=public
