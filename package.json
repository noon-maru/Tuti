{
  "name": "tuti",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm db:generate && next dev --webpack",
    "build": "pnpm build:web",
    "build:web": "pnpm db:generate && TUTI_TARGET=web next build",
    "build:app": "tsx scripts/build-capacitor-app.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "pnpm db:generate && prisma db seed",
    "db:studio": "prisma studio",
    "admin:promote": "pnpm db:generate && tsx scripts/set-user-role.ts --role admin",
    "admin:role": "pnpm db:generate && tsx scripts/set-user-role.ts",
    "places:bootstrap:tourapi": "pnpm db:generate && tsx scripts/bootstrap-tourism-places.ts",
    "places:candidates:dry-run": "pnpm db:generate && tsx scripts/dry-run-place-candidate-selection.ts",
    "places:candidates:refresh": "pnpm db:generate && tsx scripts/refresh-place-candidates.ts",
    "places:candidates:evaluate": "pnpm places:candidates:refresh -- --skip-enrichment",
    "places:editorials:enrich": "pnpm db:generate && tsx scripts/enrich-tourism-place-editorials.ts",
    "places:sync:tourapi": "pnpm db:generate && tsx scripts/sync-tourism-places.ts",
    "tourism:bootstrap:data": "pnpm db:generate && tsx scripts/bootstrap-tourism-data.ts",
    "tourism:crowd:refresh": "pnpm db:generate && tsx scripts/refresh-tourist-spot-concentration.ts",
    "tourism:timeseries:refresh": "pnpm db:generate && tsx scripts/refresh-tourism-timeseries.ts",
    "tourism:crowd:estimate": "pnpm db:generate && tsx scripts/refresh-crowd-estimates.ts",
    "transport:hubs:sync": "pnpm db:generate && tsx scripts/sync-transport-hubs.ts",
    "transport:journey:verify": "pnpm db:generate && tsx scripts/inspect-long-distance.ts",
    "llm:places:refresh": "pnpm db:generate && tsx scripts/enrich-place-meaning-profiles.ts",
    "llm:users:refresh": "pnpm db:generate && tsx scripts/refresh-user-signal-profiles.ts",
    "location:compliance:purge": "pnpm db:generate && tsx scripts/purge-location-compliance.ts",
    "location:security:inspect": "pnpm db:generate && tsx scripts/inspect-location-security.ts",
    "location:access:record": "pnpm db:generate && tsx scripts/record-location-access-change.ts",
    "auth:retention:purge": "pnpm db:generate && tsx scripts/purge-auth-retention.ts",
    "ops:objects:backup": "tsx scripts/backup-object-storage.ts",
    "ops:objects:restore": "tsx scripts/restore-object-storage.ts",
    "accommodations:sync": "pnpm db:generate && tsx scripts/sync-accommodations.ts",
    "seoul:sync:areas": "pnpm db:generate && tsx scripts/sync-seoul-realtime-areas.ts",
    "wellness:sync:kto": "pnpm db:generate && tsx scripts/sync-wellness-tourism.ts",
    "journal:trace": "tsx scripts/inspect-journal-share-trace.ts",
    "start": "next start",
    "lint": "pnpm db:generate && eslint",
    "test": "node --import tsx --test test/*.test.ts",
    "assets:generate": "capacitor-assets generate --assetPath assets/capacitor && tsx scripts/normalize-capacitor-assets.ts",
    "cap:sync": "pnpm build:app && cap sync",
    "android:sync": "pnpm build:app && cap sync android",
    "android:debug": "pnpm android:sync && cd android && ./gradlew --no-daemon assembleDebug",
    "android:release": "pnpm android:sync && cd android && ./gradlew --no-daemon bundleRelease",
    "ios:project:ensure": "tsx scripts/ensure-ios-project-link.ts",
    "ios:sync": "pnpm ios:project:ensure && pnpm build:app && cap sync ios",
    "ios:debug": "pnpm ios:sync && xcodebuild -project ios/App/Tuti.xcodeproj -scheme Tuti -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "cap:open:ios": "pnpm ios:project:ensure && open ios/App/Tuti.xcodeproj",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/ios": "8.3.4",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.11",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
