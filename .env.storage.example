# Garage가 실제 이미지와 메타데이터를 저장할 NAS 절대 경로입니다.
# 프로젝트 소스 디렉터리 밖의 전용 공유 폴더를 사용합니다.
GARAGE_STORAGE_ROOT=/volume1/tuti/object-storage

# `openssl rand -hex 32` 결과를 사용합니다.
GARAGE_RPC_SECRET=replace-with-64-character-hex-secret

# 각각 `openssl rand -base64 32` 결과를 사용합니다.
GARAGE_ADMIN_TOKEN=replace-with-random-admin-token
GARAGE_METRICS_TOKEN=replace-with-random-metrics-token

# Access Key는 `GK`와 `openssl rand -hex 16` 결과를 이어 붙입니다.
GARAGE_DEFAULT_ACCESS_KEY=GKreplace-with-32-character-hex-key
GARAGE_DEFAULT_SECRET_KEY=replace-with-64-character-hex-secret
GARAGE_DEFAULT_BUCKET=tuti-journal-images
